                                                </Grid>
                                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem ToolTip="Column">
                                <TabItem.Header>
                                    <StackPanel Width="74">
                                        <Border Style="{StaticResource TabHeaderIcon}">
                                            <Viewbox Style="{StaticResource IdentifyToolIconViewbox}">
                                                <Path Style="{StaticResource IdentifyToolIconPath}"
                                                      Data="{StaticResource IdentifyIconColumnGeometry}" />
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Style="{StaticResource Cad2ModelHeaderLabel}" Text="COLUMN" />
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#F8FAFC"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            Padding="8"
                                            Margin="0,0,0,8">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="COLUMN IDENTIFY"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2B3B4F"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,16,0" />
                                            <WrapPanel DockPanel.Dock="Right">
                                                <Button Style="{StaticResource TasColumnCommandButton}"
                                                        Content="Element Schedule"
                                                        Click="OnPickColumnScheduleClick" />
                                                <Button Style="{StaticResource TasColumnCommandButton}"
                                                        Content="Pick Sideline"
                                                        Click="OnPickColumnSidelineClick" />
                                                <Button Style="{StaticResource TasColumnCommandButton}"
                                                        Content="Pick Label"
                                                        Click="OnPickColumnLabelClick" />
                                                <Button Style="{StaticResource TasColumnCommandButton}"
                                                        Content="Auto-Identify v"
                                                        Click="OnColumnAutoIdentifyMenuClick" />
                                                <Button Style="{StaticResource TasColumnCommandButton}"
                                                        Content="Generate Revit"
                                                        Margin="0"
                                                        Click="OnGenerateClick" />
                                            </WrapPanel>
                                        </DockPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" MinWidth="520" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" MinWidth="320" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <GroupBox Grid.Row="0"
                                                          Header="1. Column Types / Schedule"
                                                          Margin="0,0,0,8">
                                                    <Grid Margin="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="190" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource TasColumnStepLabel}"
                                                                   Text="Name, Width[mm], Length[mm]" />
                                                        <DataGrid x:Name="ColumnSectionGrid"
                                                                  Grid.Row="1"
                                                                  AutoGenerateColumns="False"
                                                                  CanUserAddRows="True"
                                                                  HeadersVisibility="Column"
                                                                  Margin="0,0,0,8">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Name"
                                                                            Binding="{Binding Name}"
                                                                            Width="*" />
                                                                <DataGridTextColumn Header="Width (mm)"
                                                                            Binding="{Binding WidthMm}"
                                                                            Width="120" />
                                                                <DataGridTextColumn Header="Length (mm)"
                                                                            Binding="{Binding LengthMm}"
                                                                            Width="120" />
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <WrapPanel Grid.Row="2">
                                                            <Button Width="90"
                                                                    Height="26"
                                                                    Content="Open Excel"
                                                                    Click="OnOpenColumnExcelClick" />
                                                            <Button Width="118"
                                                                    Height="26"
                                                                    Margin="8,0,0,0"
                                                                    Content="Element Schedule"
                                                                    Click="OnPickColumnScheduleClick" />
                                                            <Button Width="90"
                                                                    Height="26"
                                                                    Margin="8,0,0,0"
                                                                    Content="Import Excel"
                                                                    Click="OnLoadColumnSectionsFromExcelClick" />
                                                            <Button Width="80"
                                                                    Height="26"
                                                                    Margin="8,0,0,0"
                                                                    Content="Paste"
                                                                    Click="OnPasteColumnSectionsClick" />
                                                            <Button Width="80"
                                                                    Height="26"
                                                                    Margin="8,0,0,0"
                                                                    Content="Clear"
                                                                    Click="OnClearColumnSectionsClick" />
                                                            <CheckBox x:Name="CreateColumnTypesCheck"
                                                                      Content="Create column types on Generate"
                                                                      IsChecked="True"
                                                                      Margin="16,0,0,0"
                                                                      VerticalAlignment="Center" />
                                                        </WrapPanel>
                                                    </Grid>
                                                </GroupBox>

                                                <GroupBox Grid.Row="1"
                                                          Header="2. Identify Source"
                                                          Margin="0,0,0,8">
                                                    <Grid Margin="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Linked DWG:" VerticalAlignment="Center" />
                                                        <TextBox x:Name="LinkNameTextBox"
                                                                 Grid.Column="1"
                                                                 Margin="8,0,8,0"
                                                                 IsReadOnly="True"
                                                                 Text="(not selected)" />
                                                        <Button Grid.Column="2"
                                                                Width="120"
                                                                Height="28"
                                                                Content="Pick Link"
                                                                Click="OnPickLinkClick" />

                                                        <TextBlock Grid.Row="1"
                                                                   Text="Entity Selection Mode:"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,8,0,0" />
                                                        <WrapPanel Grid.Row="1"
                                                                   Grid.Column="1"
                                                                   Margin="8,8,8,0">
                                                            <RadioButton x:Name="SelectModeRadio"
                                                                         Content="Free Select"
                                                                         IsChecked="True"
                                                                         Checked="OnSelectionModeChanged"
                                                                         Margin="0,0,16,0" />
                                                            <RadioButton x:Name="LayerModeRadio"
                                                                         Content="Select by layer"
                                                                         Checked="OnSelectionModeChanged"
                                                                         Margin="0,0,16,0" />
                                                            <RadioButton x:Name="ColorModeRadio"
                                                                         Content="Select by color"
                                                                         Checked="OnSelectionModeChanged" />
                                                        </WrapPanel>
                                                        <Button Grid.Row="1"
                                                                Grid.Column="2"
                                                                Width="120"
                                                                Height="28"
                                                                Margin="0,6,0,0"
                                                                Content="Pick Sideline"
                                                                Click="OnPickColumnSidelineClick" />

                                                        <TextBlock Grid.Row="2"
                                                                   Text="Layer:"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,8,0,0" />
                                                        <ComboBox x:Name="LayerCombo"
                                                                   Grid.Row="2"
                                                                   Grid.Column="1"
                                                                   Grid.ColumnSpan="2"
                                                                   Margin="8,8,0,0"
                                                                   SelectionChanged="OnCad2ModelSourceSelectionChanged"
                                                                   Height="26" />
                                                        <TextBlock Grid.Row="3"
                                                                   Text="Label Layer:"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,8,0,0" />
                                                        <ComboBox x:Name="ColumnLabelLayerCombo"
                                                                   Grid.Row="3"
                                                                   Grid.Column="1"
                                                                   Grid.ColumnSpan="2"
                                                                   Margin="8,8,0,0"
                                                                   SelectionChanged="OnCad2ModelSourceSelectionChanged"
                                                                   Height="26" />
                                                    </Grid>
                                                </GroupBox>
                                            </Grid>

                                            <GridSplitter Grid.Column="1"
                                                          Style="{StaticResource TasVerticalGridSplitter}" />

                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <GroupBox Grid.Row="0"
                                                          Header="3. Levels"
                                                          Margin="0,0,0,8">
                                                    <Grid Margin="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Base Level:" VerticalAlignment="Center" />
                                                        <ComboBox x:Name="BaseLevelCombo"
                                                                  Grid.Column="1"
                                                                  Margin="8,0,0,0"
                                                                  Height="26" />
                                                        <Button Grid.Column="2"
                                                                Width="96"
                                                                Height="26"
                                                                Margin="8,0,0,0"
                                                                Content="Reload"
                                                                Click="OnReloadClick" />

                                                        <TextBlock Grid.Row="1"
                                                                   Text="Top Level:"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,8,0,0" />
                                                        <ComboBox x:Name="TopLevelCombo"
                                                                  Grid.Row="1"
                                                                  Grid.Column="1"
                                                                  Grid.ColumnSpan="2"
                                                                  Margin="8,8,0,0"
                                                                  Height="26" />
                                                    </Grid>
                                                </GroupBox>

                                                <GroupBox Grid.Row="1"
                                                          Header="4. Column Settings"
                                                          Margin="0,0,0,8">
                                                    <Grid Margin="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="Column Type:" VerticalAlignment="Center" />
                                                        <ComboBox x:Name="ColumnTypeCombo"
                                                                  Grid.Column="1"
                                                                  Margin="8,0,0,0"
                                                                  Height="26" />
                                                        <Button Grid.Column="2"
                                                                Width="60"
                                                                Height="26"
                                                                Margin="8,0,0,0"
                                                                Content="Edit"
                                                                Click="OnEditColumnTypeClick" />
                                                    </Grid>
                                                </GroupBox>

                                                <GroupBox Grid.Row="2"
                                                          Header="5. Geometry"
                                                          Margin="0,0,0,8">
                                                    <UniformGrid Columns="1" Margin="8">
                                                        <CheckBox x:Name="CirclesCheck"
                                                                  Content="Circles (use center points)"
                                                                  IsChecked="True" />
                                                        <CheckBox x:Name="BlocksCheck"
                                                                  Content="Blocks (use insertion points)"
                                                                  IsChecked="True"
                                                                  Margin="0,4,0,0" />
                                                        <CheckBox x:Name="LinesCheck"
                                                                  Content="Lines (use intersections)"
                                                                  IsChecked="False"
                                                                  Margin="0,4,0,0" />
                                                    </UniformGrid>
                                                </GroupBox>

                                                <GroupBox Grid.Row="3"
                                                          Header="Identify Tools"
                                                          Margin="0,0,0,8">
                                                    <WrapPanel Margin="8">
                                                        <Button Width="120"
                                                                Height="28"
                                                                Content="Check Source"
                                                                Click="OnAutoDetectColumnsClick" />
                                                        <Button Width="110"
                                                                Height="28"
                                                                Margin="8,0,0,0"
                                                                Content="Pick Label"
                                                                Click="OnPickColumnLabelClick" />
                                                    </WrapPanel>
                                                </GroupBox>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem ToolTip="Wall">
                                <TabItem.Header>
                                    <StackPanel Width="74">
                                        <Border Style="{StaticResource TabHeaderIcon}">
                                            <Viewbox Style="{StaticResource IdentifyToolIconViewbox}">
                                                <Path Style="{StaticResource IdentifyToolIconPath}"
                                                      Data="{StaticResource IdentifyIconWallGeometry}" />
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Style="{StaticResource Cad2ModelHeaderLabel}" Text="WALL" />
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Generate CAD to Wall"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                            <TextBlock Text="Pick a CAD link, choose By Layer and select your wall centerline layer, then click Generate."
                                               Margin="0,0,0,12" />

                                            <GroupBox Header="CAD Source" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Linked DWG:" VerticalAlignment="Center" />
                                                    <TextBox x:Name="LinkNameTextBox_Wall"
                                                     Grid.Column="1"
                                                     Margin="8,0,8,0"
                                                     IsReadOnly="True"
                                                     Text="(not selected)" />
                                                    <Button Grid.Column="2"
                                                    Width="120"
                                                    Height="28"
                                                    Content="Pick Link"
                                                    Click="OnPickLinkClick" />

                                                    <TextBlock Grid.Row="1" Text="Selection Mode:" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,8,0">
                                                        <RadioButton x:Name="SelectModeRadio_Wall"
                                                             Content="Select Objects"
                                                             Checked="OnSelectionModeChanged"
                                                             Margin="0,0,16,0" />
                                                        <RadioButton x:Name="LayerModeRadio_Wall"
                                                             Content="By Layer"
                                                             IsChecked="True"
                                                             Checked="OnSelectionModeChanged" />
                                                    </StackPanel>
                                                    <Button Grid.Row="1"
                                                    Grid.Column="2"
                                                    Width="120"
                                                    Height="28"
                                                    Content="Pick Objects"
                                                    Click="OnPickObjectsClick" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Layer Filter" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Wall Layer:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="LayerCombo_Wall"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       SelectionChanged="OnCad2ModelSourceSelectionChanged"
                                                       Height="26" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Wall Types (Excel)" Margin="0,0,0,12">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Paste from Excel: Name, Width[mm] (used to create wall types)"
                                                       Margin="0,0,0,6" />
                                                    <DataGrid x:Name="WallSectionGrid"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="True"
                                                      HeadersVisibility="Column"
                                                      Height="120"
                                                      Margin="0,0,0,8">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}"
                                                                        Width="*" />
                                                            <DataGridTextColumn Header="Width (mm)"
                                                                        Binding="{Binding WidthMm}"
                                                                        Width="140" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Width="90"
                                                        Height="26"
                                                        Content="Open Excel"
                                                        Click="OnOpenWallExcelClick" />
                                                        <Button Width="90"
                                                        Height="26"
                                                        Margin="8,0,0,0"
                                                        Content="Pick Table"
                                                        Click="OnPickWallScheduleClick" />
                                                        <Button Width="80"
                                                        Height="26"
                                                        Margin="8,0,0,0"
                                                        Content="Paste"
                                                        Click="OnPasteWallSectionsClick" />
                                                        <Button Width="80"
                                                        Height="26"
                                                        Margin="8,0,0,0"
                                                        Content="Clear"
                                                        Click="OnClearWallSectionsClick" />
                                                        <CheckBox x:Name="CreateWallTypesCheck"
                                                          Content="Create wall types on Generate"
                                                          IsChecked="True"
                                                          Margin="16,0,0,0"
                                                          VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </GroupBox>

                                            <GroupBox Header="Smart Tools" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" Margin="8">
                                                    <Button Width="120"
                                                    Height="26"
                                                    Content="Auto Detect"
                                                    Click="OnAutoDetectWallsClick" />
                                                    <TextBlock Text="Auto-select layer and preview count."
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                                </StackPanel>
                                            </GroupBox>

                                            <GroupBox Header="Wall Settings" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Wall Type:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="WallTypeCombo"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      Height="26" />
                                                    <Button Grid.Column="2"
                                                    Width="60"
                                                    Height="26"
                                                    Margin="8,0,0,0"
                                                    Content="Edit"
                                                    Click="OnEditWallTypeClick" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Levels" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Base Level:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="WallBaseLevelCombo"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      Height="26" />

                                                    <TextBlock Grid.Row="1" Text="Top Level:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="WallTopLevelCombo"
                                                      Grid.Row="1"
                                                      Grid.Column="1"
                                                      Margin="8,6,0,0"
                                                      Height="26" />
                                                </Grid>
                                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem ToolTip="Beam">

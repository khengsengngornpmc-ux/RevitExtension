                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                    <DataTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                                                            <Setter TargetName="SelectedText" Property="Visibility" Value="Visible" />
                                                                                            <Setter TargetName="DropDownText" Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </DataTemplate.Triggers>
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTextColumn Header="Unit"
                                                                                Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                Width="70" />
                                                            <DataGridTemplateColumn Header="Rule Type" Width="150">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <ComboBox ItemsSource="{Binding MethodChoiceItems}"
                                                                                  SelectedValue="{Binding Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  SelectedValuePath="Value"
                                                                                  IsEditable="False"
                                                                                  IsTextSearchEnabled="True"
                                                                                  TextSearch.TextPath="Value"
                                                                                  Height="23"
                                                                                  Padding="3,0"
                                                                                  BorderThickness="1"
                                                                                  BorderBrush="#AFC3DE"
                                                                                  Background="White"
                                                                                  VerticalContentAlignment="Center">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid MinWidth="260">
                                                                                        <TextBlock x:Name="SelectedText"
                                                                                                   Text="{Binding Value}"
                                                                                                   Visibility="Collapsed" />
                                                                                        <StackPanel x:Name="DropDownText" Margin="2,3">
                                                                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Foreground="#17365D" />
                                                                                            <TextBlock Text="{Binding Description}" Foreground="#5B6C8B" FontSize="10" TextWrapping="Wrap" />
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                    <DataTemplate.Triggers>
                                                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                                                            <Setter TargetName="SelectedText" Property="Visibility" Value="Visible" />
                                                                                            <Setter TargetName="DropDownText" Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </DataTemplate.Triggers>
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </TabItem>
                                            </TabControl>

                                            <TextBlock Grid.Row="3"
                                                       Foreground="#5B6C8B"
                                                       TextWrapping="Wrap"
                                                       Text="Measurement Rules define Cubicost TAS output sheets, classification columns, quantity headers, and MHNK shared-parameter mappings." />
                                        </Grid>
                                    </GroupBox>
                                </TabItem>

                                <TabItem x:Name="QsViewExpressionTab"
                                         Header="View Expression">
                                    <GroupBox Header="View Expression" Margin="0">
                                        <Grid Margin="10">
                                            <Border BorderBrush="#C9D6EA"
                                                    BorderThickness="1"
                                                    Background="#F8FBFF"
                                                    Padding="10">
                                                <WrapPanel>
                                                    <Button Width="150"
                                                            Height="28"
                                                            Style="{StaticResource PrimaryActionButton}"
                                                            Content="View Expression"
                                                            Click="OnQsViewExpressionClick" />
                                                    <Button Width="170"
                                                            Height="28"
                                                            Margin="8,0,0,0"
                                                            Content="Hide/Show Formwork Shape"
                                                            Click="OnQsHideFormworkShapesClick" />
                                                    <Button Width="180"
                                                            Height="28"
                                                            Margin="8,0,0,0"
                                                            Content="Delete Formwork Shape"
                                                            Click="OnQsDeleteFormworkShapesClick" />
                                                </WrapPanel>
                                            </Border>
                                        </Grid>
                                    </GroupBox>
                                </TabItem>

                                <TabItem Header="Rule Calculation Formwork">
                                    <GroupBox Header="Rule Calculation Formwork" Margin="0">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">
                                                <TextBlock Text="Shared Parameter Group: CBIM-QS" FontWeight="SemiBold" Foreground="#244061" />
                                                <TextBlock Margin="0,2,0,8"
                                           Text="Definitions are grouped by element type and can be expanded/collapsed."
                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,0,0,10"
                                           Text="Unified level parameters: CBIM_StructuralPlan and CBIM_BuildingLevel. Value is mapped from native category fields (Column=Base Level, Foundation/Floor=Level, Framing=Reference Level, Wall=Base Constraint, Stair=Base Level) and matched to Structural Plan view name when available."
                                           TextWrapping="Wrap"
                                           Foreground="#244061" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                <Button Width="110" Height="24" Content="Expand All" Click="OnQsExpandAllDefinitionClick" />
                                                <Button Width="110" Height="24" Margin="8,0,0,0" Content="Collapse All" Click="OnQsCollapseAllDefinitionClick" />
                                            </StackPanel>

                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <Expander x:Name="QsDefBoredPileExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Bored Pile" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Category mapping: usually modeled under Structural Foundation." TextWrapping="Wrap" />
                                                            <TextBlock Text="Parameters: CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Foun.Sides, FWK.Foun.Top, FWK.Foun.SubFoun, FWK.Foun.SubBeam, FWK.Foun.SubCol, FWK.Foun.SubWall, FWK.Foun.SubFloor, FWK.Foun.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Formula: CBIM_FormworkArea = FWK.Foun.Sides + optional FWK.Foun.Top - FWK.Foun.SubFoun - FWK.Foun.SubBeam - FWK.Foun.SubCol - FWK.Foun.SubWall - FWK.Foun.SubFloor - FWK.Foun.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefFoundationExpander" IsExpanded="True" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Foundation" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Parameters: CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Foun.Sides, FWK.Foun.Top, FWK.Foun.SubFoun, FWK.Foun.SubBeam, FWK.Foun.SubCol, FWK.Foun.SubWall, FWK.Foun.SubFloor, FWK.Foun.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Formula: CBIM_FormworkArea = FWK.Foun.Sides + optional FWK.Foun.Top - FWK.Foun.SubFoun - FWK.Foun.SubBeam - FWK.Foun.SubCol - FWK.Foun.SubWall - FWK.Foun.SubFloor - FWK.Foun.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefLeanConcreteExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Lean Concrete" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Recommended modeling category: Structural Foundation or Structural Floor." TextWrapping="Wrap" />
                                                            <TextBlock Text="Parameters (as Foundation): CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Foun.*"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Parameters (as Structural Floor): CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Floor.*"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefColumnExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Structural Column" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Parameters: CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Col.Sides, FWK.Col.SubFoun, FWK.Col.SubBeam, FWK.Col.SubCol, FWK.Col.SubWall, FWK.Col.SubFloor, FWK.Col.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Formula: CBIM_FormworkArea = FWK.Col.Sides - FWK.Col.SubFoun - FWK.Col.SubBeam - FWK.Col.SubCol - FWK.Col.SubWall - FWK.Col.SubFloor - FWK.Col.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefWallExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Structural Wall" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Parameters: CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Wall.Total, FWK.Wall.SubFoun, FWK.Wall.SubBeam, FWK.Wall.SubCol, FWK.Wall.SubWall, FWK.Wall.SubFloor, FWK.Wall.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Rule: 'Calculate bottom faces of Opening' adds opening-bottom area into FWK.Wall.Total."
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Formula: CBIM_FormworkArea = FWK.Wall.Total - FWK.Wall.SubFoun - FWK.Wall.SubBeam - FWK.Wall.SubCol - FWK.Wall.SubWall - FWK.Wall.SubFloor - FWK.Wall.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefBeamExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Structural Framing (Beam)" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Parameters: CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Beam.Total, FWK.Beam.Bottom, FWK.Beam.SubFoun, FWK.Beam.SubBeam, FWK.Beam.SubCol, FWK.Beam.SubWall, FWK.Beam.SubFloor, FWK.Beam.SubGeneric, CBIM_Beam_Length, CBIM_Beam_Width, CBIM_Beam_Depth, CBIM_Beam_Volume, CBIM_Beam_Type, CBIM_Beam_Level"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Formula: CBIM_FormworkArea = FWK.Beam.Total - FWK.Beam.SubFoun - FWK.Beam.SubBeam - FWK.Beam.SubCol - FWK.Beam.SubWall - FWK.Beam.SubFloor - FWK.Beam.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefFloorExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Structural Floor" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Parameters: CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Floor.Bottom, FWK.Floor.Sides, FWK.Floor.SubFoun, FWK.Floor.SubBeam, FWK.Floor.SubCol, FWK.Floor.SubWall, FWK.Floor.SubFloor, FWK.Floor.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Formula: CBIM_FormworkArea = FWK.Floor.Bottom + FWK.Floor.Sides - FWK.Floor.SubFoun - FWK.Floor.SubBeam - FWK.Floor.SubCol - FWK.Floor.SubWall - FWK.Floor.SubFloor - FWK.Floor.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefStairExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Structural Stair" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Parameters: CBIM_StructuralPlan, FWK.Enable, FWK.EnableSelf, CBIM_FormworkArea, FWK.Stair.Painting, FWK.Stair.PaintingSide, FWK.Stair.PaintingBottom, FWK.Stair.Sides, FWK.Stair.Bottom, FWK.Stair.Top, FWK.Stair.SubFoun, FWK.Stair.SubBeam, FWK.Stair.SubCol, FWK.Stair.SubWall, FWK.Stair.SubFloor, FWK.Stair.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Formula: CBIM_FormworkArea = FWK.Stair.Painting - FWK.Stair.SubFoun - FWK.Stair.SubBeam - FWK.Stair.SubCol - FWK.Stair.SubWall - FWK.Stair.SubFloor - FWK.Stair.SubGeneric"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefSoilExcavationExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Soil Excavation" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Category mapping: MHNK Soil Excavation DirectShape elements in Generic Model."
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Shared Parameters: CBIM_SoilExcavationVolume, CBIM_SoilBackfilledVolume (Generic Model, CBIM-QS group)."
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Rule (BOQ): Soil Excavation = union net volume of MHNK Soil Excavation DirectShapes in selected scope."
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefSoilBackfilledExpander" IsExpanded="False" Margin="0,0,0,6">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Soil Backfilled" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Category mapping: derived from MHNK Soil Excavation DirectShapes (Generic Model)."
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Shared Parameters: CBIM_SoilExcavationVolume, CBIM_SoilBackfilledVolume (for QS/BOQ schedule compatibility)."
                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="Rule (BOQ): Soil Backfilled = Soil Excavation - intersecting structural element volumes (Foundation, Column, Wall, Framing, Floor, Stair)."
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>

                                                    <Expander x:Name="QsDefShapeExpander" IsExpanded="False">
                                                        <Expander.Header>
                                                            <Border Background="#1F84D1" Padding="6,4">
                                                                <TextBlock Text="Specialty Equipment (Formwork Shape)" Foreground="White" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Expander.Header>
                                                        <StackPanel Margin="10,6,10,8">
                                                            <TextBlock Text="Parameters: CBIM.FormworkShape, CBIM.FWK.IsShape, CBIM.FWK.Category, CBIM.FWK.ElementId, CBIM.FWK.FaceType, CBIM.FWK.FaceArea, CBIM.FWK.Level"
                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </GroupBox>
                                </TabItem>

                                <TabItem Header="BOQ Table">
                                    <GroupBox Header="BOQ Table" Margin="0">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" BorderBrush="#2E75B6" BorderThickness="1" Background="#F5F9FF" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Structure Element" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Row="0"
                                              Grid.Column="1"
                                              x:Name="BoqElementFilterCombo"
                                              Height="26"
                                              Margin="8,0,0,0"
                                              SelectionChanged="OnBoqFilterChanged" />

                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Building Level" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Row="0"
                                              Grid.Column="4"
                                              x:Name="BoqBuildingLevelFilterCombo"
                                              Height="26"
                                              Margin="8,0,0,0"
                                              SelectionChanged="OnBoqFilterChanged" />

                                                    <StackPanel Grid.Row="0"
                                                Grid.Column="6"
                                                Orientation="Horizontal"
                                                Margin="12,0,0,0">
                                                        <Button Width="90"
                                                Height="28"
                                                Style="{StaticResource PrimaryActionButton}"
                                                Content="Refresh"
                                                Click="OnBoqRefreshClick" />
                                                        <Button Width="110"
                                                Height="28"
                                                Margin="8,0,0,0"
                                                Content="Copy (Excel)"
                                                Click="OnBoqCopyClick" />
                                                        <Button Width="100"
                                                Height="28"
                                                Margin="8,0,0,0"
                                                Content="Export Excel"
                                                Click="OnBoqExportExcelClick" />
                                                        <Button Width="118"
                                                Height="28"
                                                Margin="8,0,0,0"
                                                Content="Export TAS"
                                                Click="OnBoqExportTasExcelClick" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="7"
                                                Orientation="Horizontal"
                                                Margin="0,10,0,0">
                                                        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <RadioButton x:Name="BoqScopeViewRadio" Content="Current View" IsChecked="True" Margin="0,0,12,0" />
                                                        <RadioButton x:Name="BoqScopeSelectionRadio" Content="Current Selection" Margin="0,0,12,0" />
                                                        <RadioButton x:Name="BoqScopeAllRadio" Content="Entire Model" />
                                                        <TextBlock Text="Pivot:" VerticalAlignment="Center" Margin="16,0,6,0" />
                                                        <ComboBox x:Name="BoqPivotModeCombo"
                                                  Width="220"
                                                  Height="24"
                                                  SelectionChanged="OnBoqFilterChanged" />
                                                        <CheckBox x:Name="BoqAutoSyncCsvCheck"
                                                  Content="Auto sync linked Excel / last CSV after Refresh or Generate"
                                                  Margin="16,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Rows (Shown)" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="BoqKpiRowsText" Text="0" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Rows (Source)" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="BoqKpiSourceRowsText" Text="0" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Levels" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="BoqKpiLevelsText" Text="0" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Mode" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="BoqKpiModeText" Text="Detail (Type)" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Grid.Row="2"
                                       x:Name="BoqSummaryText"
                                       Foreground="#5B6C8B"
                                       Margin="0,0,0,6"
                                       Text="Click Refresh to load BOQ table." />

                                            <Grid Grid.Row="3">
                                                <DataGrid x:Name="BoqTableGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Extended"
                                          SelectionUnit="Cell"
                                          ClipboardCopyMode="ExcludeHeader"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          RowBackground="White"
                                          AlternatingRowBackground="#F8FBFF"
                                          AlternationCount="2"
                                          PreviewMouseLeftButtonDown="OnBoqGridPreviewMouseLeftButtonDown"
                                          PreviewMouseMove="OnBoqGridPreviewMouseMove">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Structure Element" Binding="{Binding StructureElement}" Width="170" />
                                                        <DataGridTextColumn Header="Building Level" Binding="{Binding BuildingLevel}" Width="170" />
                                                        <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="160" />
                                                        <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="*" />
                                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                                                        <DataGridTextColumn Header="Volume (m3)" Binding="{Binding TotalVolumeM3, StringFormat={}{0:N3}}" Width="120" />
                                                        <DataGridTextColumn Header="Formwork (m2)" Binding="{Binding TotalFormworkAreaM2, StringFormat={}{0:N3}}" Width="130" />
                                                        <DataGridTextColumn Header="Rule Code" Binding="{Binding QsRuleCode}" Width="180" />
                                                        <DataGridTextColumn Header="Formula" Binding="{Binding QsFormula}" Width="260" />
                                                        <DataGridTextColumn Header="Breakdown" Binding="{Binding QsBreakdown}" Width="420" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock x:Name="BoqEmptyStateText"
                                           Text="No BOQ rows yet. Click Refresh to load data."
                                           Foreground="#6B7C96"
                                           FontStyle="Italic"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Visible"
                                           IsHitTestVisible="False" />
                                            </Grid>
                                        </Grid>
                                    </GroupBox>
                                </TabItem>

                                <TabItem x:Name="BoqReportTab" Header="BOQ Report">
                                    <GroupBox Header="BOQ Report" Margin="0">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" BorderBrush="#D5DEE9" BorderThickness="1" Background="#F8FBFF" Padding="8" Margin="0,0,0,8">
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                        <TextBlock Text="Floor Range" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                        <ComboBox x:Name="BoqReportFloorFromCombo"
                                                                  Width="120"
                                                                  Height="28"
                                                                  Margin="8,0,0,0"
                                                                  SelectionChanged="OnBoqReportFilterChanged" />
                                                        <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                                                        <ComboBox x:Name="BoqReportFloorToCombo"
                                                                  Width="120"
                                                                  Height="28"
                                                                  SelectionChanged="OnBoqReportFilterChanged" />
                                                        <Separator Width="1" Margin="12,0" />
                                                        <TextBlock Text="Quantity" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                        <ComboBox x:Name="BoqReportQuantityScopeCombo"
                                                                  Width="170"
                                                                  Height="28"
                                                                  Margin="8,0,0,0"
                                                                  SelectionChanged="OnBoqReportFilterChanged" />
                                                        <Separator Width="1" Margin="12,0" />
                                                        <TextBlock Text="Number of Auto-Fit Pages" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox x:Name="BoqReportAutoFitPagesText" Width="42" Height="26" Text="1" IsReadOnly="True" VerticalContentAlignment="Center" TextAlignment="Center" />
                                                        <Button Width="72" Height="28" Margin="10,0,0,0" Content="Adaptive" Click="OnBoqReportAdaptiveClick" />
                                                        <Button Width="86" Height="28" Margin="8,0,0,0" Content="Zoom In" IsEnabled="False" />
                                                        <Button Width="86" Height="28" Margin="8,0,0,0" Content="Zoom Out" IsEnabled="False" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Width="112" Height="44" Content="Export Workbook" Click="OnBoqReportExportExcelClick" />
                                                        <Button Width="76" Height="44" Margin="8,0,0,0" Content="Print" Click="OnBoqReportPrintClick" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="330" />
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" BorderBrush="#D5DEE9" BorderThickness="1" Background="White" Margin="0,0,8,0">
                                                    <TreeView x:Name="BoqReportTree" SelectedItemChanged="OnBoqReportTreeSelectedItemChanged">
                                                        <TreeViewItem Header="Quantity Summary" IsExpanded="True">
                                                            <TreeViewItem Header="Quantity Summary (by Segmentation)" Tag="SummaryBySegmentation" />
                                                            <TreeViewItem x:Name="BoqReportDefaultTreeItem" Header="Quantity Summary (by Element)" Tag="SummaryByElement" IsSelected="True" />
                                                            <TreeViewItem Header="Quantity Summary (Column 1)" Tag="SummaryColumn1" />
                                                            <TreeViewItem Header="Quantity Summary (Column 2)" Tag="SummaryColumn2" />
                                                            <TreeViewItem Header="Quantity Summary (Door/Window)" Tag="SummaryDoorWindow" />
                                                            <TreeViewItem Header="Quantity Summary (Wall Finish)" Tag="SummaryWallFinish" />
                                                            <TreeViewItem Header="Quantity Summary (P-Structure)" Tag="SummaryPStructure" />
                                                            <TreeViewItem Header="Quantity Summary (P-Finishes)" Tag="SummaryPFinishes" />
                                                        </TreeViewItem>
                                                        <TreeViewItem Header="Quantity Measurement Worksheet" IsExpanded="True">
                                                            <TreeViewItem Header="Quantity Measurement Worksheet (Expression)" Tag="WorksheetExpression" />
                                                            <TreeViewItem Header="Quantity Measurement Worksheet (Wall)" Tag="WorksheetWall" />
                                                        </TreeViewItem>
                                                        <TreeViewItem Header="Index Summary Analysis" IsExpanded="True">
                                                            <TreeViewItem Header="Single-Unit Concrete Index Table" Tag="IndexConcreteUnit" />
                                                            <TreeViewItem Header="Project Overall Index Table" Tag="IndexOverall" />
                                                            <TreeViewItem Header="Concrete Grade Index Table" Tag="IndexConcreteGrade" />
                                                            <TreeViewItem Header="Steel Ratio Index Table" Tag="IndexSteelRatio" />
                                                        </TreeViewItem>
                                                        <TreeViewItem Header="Steel Structure Detail" IsExpanded="True">
                                                            <TreeViewItem Header="Structural Steel Summary" Tag="SteelSummary" />
                                                            <TreeViewItem Header="Plate Summary" Tag="SteelPlate" />
                                                            <TreeViewItem Header="Bolt Summary" Tag="SteelBolt" />
                                                            <TreeViewItem Header="Anchor Bolt Summary" Tag="SteelAnchorBolt" />
                                                            <TreeViewItem Header="Shear Stud Summary" Tag="SteelShearStud" />
                                                        </TreeViewItem>
                                                        <TreeViewItem Header="Material Summary" IsExpanded="True">
                                                            <TreeViewItem Header="Tile Schedule (by Spec)" Tag="MaterialTileSpec" />
                                                            <TreeViewItem Header="Tile Schedule (by Room)" Tag="MaterialTileRoom" />
                                                        </TreeViewItem>
                                                    </TreeView>
                                                </Border>

                                                <Border Grid.Column="1" BorderBrush="#D5DEE9" BorderThickness="1" Background="White" Margin="0,0,8,0">
                                                    <TreeView x:Name="BoqReportCategoryTree" SelectedItemChanged="OnBoqReportCategoryTreeSelectedItemChanged">
                                                        <TreeView.ItemTemplate>
                                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                                <TextBlock Text="{Binding Name}" />
                                                            </HierarchicalDataTemplate>
                                                        </TreeView.ItemTemplate>
                                                    </TreeView>
                                                </Border>

                                                <Border Grid.Column="2" Background="#858585">
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  Padding="20">
                                                        <Border Background="White"
                                                                BorderBrush="#1D1D1D"
                                                                BorderThickness="1"
                                                                MinWidth="760"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Top"
                                                                Padding="28,26,28,26">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>

                                                                <TextBlock x:Name="BoqReportTitleText"
                                                                           Text="Quantity Summary (by Element)"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,0,0,14" />

                                                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                                                    <TextBlock x:Name="BoqReportProjectText"
                                                                               Text="Project Name: Template"
                                                                               FontWeight="SemiBold"
                                                                               DockPanel.Dock="Left" />
                                                                    <TextBlock x:Name="BoqReportCompileDateText"
                                                                               Text="Compile Date:"
                                                                               FontWeight="SemiBold"
                                                                               HorizontalAlignment="Right"
                                                                               DockPanel.Dock="Right" />
                                                                </DockPanel>

                                                                <Grid Grid.Row="2">
                                                                    <DataGrid x:Name="BoqReportGrid"
                                                                              AutoGenerateColumns="False"
                                                                              IsReadOnly="True"
                                                                              CanUserAddRows="False"
                                                                              CanUserDeleteRows="False"
                                                                              SelectionMode="Extended"
                                                                              SelectionUnit="Cell"
                                                                              HeadersVisibility="Column"
                                                                              GridLinesVisibility="All"
                                                                              RowBackground="White"
                                                                              AlternatingRowBackground="#F2FBFC"
                                                                              AlternationCount="2"
                                                                              MinHeight="560"
                                                                              BorderBrush="#1D1D1D"
                                                                              BorderThickness="1"
                                                                              ColumnHeaderHeight="34"
                                                                              RowHeight="24"
                                                                              FrozenColumnCount="2">
                                                                        <DataGrid.ColumnHeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader">
                                                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                                <Setter Property="FontSize" Value="11" />
                                                                                <Setter Property="Padding" Value="4,2" />
                                                                                <Setter Property="ContentTemplate">
                                                                                    <Setter.Value>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding}"
                                                                                                       TextWrapping="Wrap"
                                                                                                       TextAlignment="Center"
                                                                                                       LineHeight="13" />
                                                                                        </DataTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </DataGrid.ColumnHeaderStyle>
                                                                        <DataGrid.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="Padding" Value="3,0" />
                                                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                                                <Setter Property="BorderBrush" Value="#1D1D1D" />
                                                                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                                            </Style>
                                                                        </DataGrid.CellStyle>
                                                                        <DataGrid.RowStyle>
                                                                            <Style TargetType="DataGridRow">
                                                                                <Setter Property="FontSize" Value="11" />
                                                                                <Setter Property="MinHeight" Value="24" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSubtotal}" Value="True">
                                                                                        <Setter Property="Background" Value="#E6F6F8" />
                                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                                                        <Setter Property="Background" Value="#9DC3E6" />
                                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </DataGrid.RowStyle>
                                                                    </DataGrid>
                                                                    <TextBlock x:Name="BoqReportEmptyStateText"
                                                                               Text="No BOQ report rows yet. Refresh BOQ Table or Generate QS first."
                                                                               Foreground="#6B7C96"
                                                                               FontStyle="Italic"
                                                                               FontSize="13"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="Visible"
                                                                               IsHitTestVisible="False" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       x:Name="BoqReportSummaryText"
                                                       Foreground="#5B6C8B"
                                                       Margin="0,8,0,0"
                                                       Text="BOQ Report is ready. Refresh BOQ Table or Generate QS to load quantities." />
                                        </Grid>
                                    </GroupBox>
                                </TabItem>

                                <TabItem x:Name="PrepareBoqTab"
                             Header="Prepare BOQ"
                             AllowDrop="True"
                             PreviewDragOver="OnPrepareBoqTabPreviewDragOver"
                             Drop="OnPrepareBoqTabDrop">
                                    <GroupBox Header="Prepare BOQ" Margin="0">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" BorderBrush="#2E75B6" BorderThickness="1" Background="#F5F9FF" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Width="130"
                                            Height="28"
                                            Style="{StaticResource PrimaryActionButton}"
                                            Content="Create from BOQ"
                                            Click="OnPrepareBoqCreateFromBoqClick" />
                                                    <Button Width="110"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Content="Import Excel/CSV"
                                            Click="OnPrepareBoqImportCsvClick" />
                                                    <Button Width="120"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Content="Sync from BOQ"
                                            Click="OnPrepareBoqSyncFromBoqClick" />
                                                    <Button Width="100"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Content="Export Excel"
                                            Click="OnPrepareBoqExportExcelClick" />
                                                    <Button Width="80"
                                            Height="28"
                                            Margin="8,0,0,0"
                                            Content="Clear"
                                            Click="OnPrepareBoqClearClick" />
                                                </StackPanel>
                                            </Border>

                                            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Rows" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="PrepareBoqKpiRowsText" Text="0" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Enabled" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="PrepareBoqKpiEnabledText" Text="0" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Volume (m3)" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="PrepareBoqKpiVolumeText" Text="0.000" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource InfoChipBorderStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="Formwork (m2)" Style="{StaticResource InfoChipLabelStyle}" />
                                                        <TextBlock x:Name="PrepareBoqKpiFormworkText" Text="0.000" Style="{StaticResource InfoChipValueStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Grid.Row="2"
                                       x:Name="PrepareBoqSummaryText"
                                       Foreground="#5B6C8B"
                                       Margin="0,0,0,6"
                                       Text="Import Excel template, then drag BOQ rows into Prepare BOQ. Sync from BOQ updates linked rows before final export." />

                                            <Grid Grid.Row="3">
                                                <DataGrid x:Name="PrepareBoqGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Extended"
                                          SelectionUnit="CellOrRowHeader"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          RowBackground="White"
                                          AlternatingRowBackground="#F8FBFF"
                                          AlternationCount="2"
                                          AllowDrop="True"
                                          PreviewDragOver="OnPrepareBoqGridPreviewDragOver"
                                          Drop="OnPrepareBoqGridDrop" />
                                                <TextBlock x:Name="PrepareBoqEmptyStateText"
                                           Text="Prepare BOQ is empty. Use Create from BOQ or Import Excel/CSV."
                                           Foreground="#6B7C96"
                                           FontStyle="Italic"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Visible"
                                           IsHitTestVisible="False" />
                                            </Grid>
                                        </Grid>
                                    </GroupBox>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="LINKSHEET">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="10"
                            Background="#F6F9FD"
                            BorderBrush="#D0D9E6"
                            BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Orientation="Horizontal">
                                    <Image Width="24"
                                       Height="24"
                                       Margin="0,0,8,0"
                                       Source="/images/MHNK_32.png" />
                                    <StackPanel>
                                        <TextBlock Text="LinkSheet Workspace"
                                               FontWeight="SemiBold"
                                               Foreground="#23456B" />
                                        <TextBlock Text="Collect Revit model data, review fields, then export."
                                               Foreground="#4B5A73" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="10,4"
                                    Background="#EAF0F8"
                                    BorderBrush="#D0D9E6"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                    <TextBlock x:Name="LinksheetScopeBadgeText"
                                           Foreground="#2D4B71"
                                           FontWeight="SemiBold"
                                           Text="Scope: Whole Model" />
                                </Border>

                                <Grid Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0"
                                          Header="Step 1: Refresh Schedules"
                                          Margin="0,0,10,0">
                                        <Grid Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                   Foreground="#4B5A73"
                                                   Text="Load schedules from current model."

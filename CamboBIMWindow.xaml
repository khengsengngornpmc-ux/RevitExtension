                                            </Grid.ColumnDefinitions>

                                            <GroupBox Grid.Column="0" Header="Package" Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="6" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Text="Name" />
                                                    <TextBox x:Name="ShopDrawingPackageTextBox"
                                                             Grid.Column="1"
                                                             Height="24"
                                                             Text="SHOP DRAWING PACKAGE"
                                                             VerticalContentAlignment="Center" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Text="Discipline" />
                                                    <TextBox x:Name="ShopDrawingDisciplineTextBox"
                                                             Grid.Row="2"
                                                             Grid.Column="1"
                                                             Height="24"
                                                             Text="STRUCTURAL"
                                                             VerticalContentAlignment="Center" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Grid.Column="2" Header="Review / Title Block" Padding="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Text="Rev" />
                                                    <TextBox x:Name="ShopDrawingRevisionTextBox"
                                                             Grid.Column="1"
                                                             Height="24"
                                                             Text="R0"
                                                             VerticalContentAlignment="Center" />
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,5,0" Text="Prepared" />
                                                    <TextBox x:Name="ShopDrawingPreparedByTextBox"
                                                             Grid.Column="4"
                                                             Height="24"
                                                             VerticalContentAlignment="Center" />
                                                    <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="0,0,5,0" Text="Checked" />
                                                    <TextBox x:Name="ShopDrawingCheckedByTextBox"
                                                             Grid.Column="7"
                                                             Height="24"
                                                             VerticalContentAlignment="Center" />
                                                    <TextBlock Grid.Column="9" VerticalAlignment="Center" Margin="0,0,5,0" Text="Approved" />
                                                    <TextBox x:Name="ShopDrawingApprovedByTextBox"
                                                             Grid.Column="10"
                                                             Height="24"
                                                             VerticalContentAlignment="Center" />
                                                </Grid>
                                            </GroupBox>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="3"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            Background="White"
                                            Padding="12"
                                            Margin="0,0,0,8">
                                        <UniformGrid Columns="5" Rows="1">
                                            <Button Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="Selected Element Views"
                                                    Click="OnShopDrawingGenerateSelectedElementViewsClick" />
                                            <Button Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="Generate Formwork Layout"
                                                    Click="OnShopDrawingGenerateFormworkClick" />
                                            <Button Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="Generate Rebar Drawings"
                                                    Click="OnShopDrawingGenerateRebarClick" />
                                            <Button Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="Create Construction Sheets"
                                                    Click="OnShopDrawingCreateSheetsClick" />
                                            <Button Height="32"
                                                    Content="Generate All"
                                                    Click="OnShopDrawingGenerateAllClick" />
                                        </UniformGrid>
                                    </Border>

                                    <Border Grid.Row="4"
                                            BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            Background="White"
                                            Padding="12">
                                        <TextBlock x:Name="ShopDrawingStatusText"
                                                   Foreground="#4B5A73"
                                                   TextWrapping="Wrap"
                                                   Text="Ready." />
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="SLAB">
                                <Grid Margin="0,6,0,0">
                                    <Border BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            Background="White"
                                            Padding="12">
                                        <TextBlock Foreground="#4B5A73"
                                                   Text="SLAB reinforcement tool is under development." />
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="STAIR">
                                <Grid Margin="0,6,0,0">
                                    <Border BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            Background="White"
                                            Padding="12">
                                        <TextBlock Foreground="#4B5A73"
                                                   Text="STAIR reinforcement tool is under development." />
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <TabItem Header="SITE PROGRESS">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TabControl x:Name="SiteProgressSubTabControl"
                                Grid.Row="0"
                                Margin="0,0,0,6"
                                SelectedIndex="0">
                            <TabItem Header="DETAIL PROGRESS" />
                            <TabItem Header="SUMMARY PROGRESS" />
                            <TabItem Header="PROGRESS DASHBORD" />
                        </TabControl>

                        <GroupBox Grid.Row="1" Header="Update Progress" Margin="0">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=SiteProgressSubTabControl}"
                                                 Value="2">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <StackPanel Margin="8">
                                <TextBlock Text="Select elements in Revit, input Reinforcement/Formwork/Volume %, then apply."
                                       Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Reinf(%):"
                                           VerticalAlignment="Center" />
                                    <TextBox x:Name="SiteProgressReinforcementPercentTextBox"
                                         Grid.Column="1"
                                         Height="24"
                                         Margin="8,0,12,0"
                                         VerticalContentAlignment="Center"
                                         Text="0" />

                                    <TextBlock Grid.Column="2"
                                           Text="Formwork(%):"
                                           VerticalAlignment="Center" />
                                    <TextBox x:Name="SiteProgressFormworkPercentTextBox"
                                         Grid.Column="3"
                                         Height="24"
                                         Margin="8,0,12,0"
                                         VerticalContentAlignment="Center"
                                         Text="0" />

                                    <TextBlock Grid.Column="4"
                                           Text="Volume(%):"
                                           VerticalAlignment="Center" />
                                    <TextBox x:Name="SiteProgressVolumePercentTextBox"
                                         Grid.Column="5"
                                         Height="24"
                                         Margin="8,0,12,0"
                                         VerticalContentAlignment="Center"
                                         Text="0" />

                                    <RadioButton x:Name="SiteProgressSetModeRadio"
                                             Grid.Column="6"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             Content="Set"
                                             IsChecked="True" />
                                    <RadioButton x:Name="SiteProgressAddModeRadio"
                                             Grid.Column="7"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             Content="Add (+)" />

                                    <StackPanel Grid.Column="9"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="Pivot:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                        <ComboBox x:Name="SiteProgressPivotModeCombo"
                                              Height="26"
                                              Width="150"
                                              Margin="0,0,12,0"
                                              SelectionChanged="OnSiteProgressPivotChanged" />
                                        <TextBlock Text="Metric:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                        <ComboBox x:Name="SiteProgressPivotMetricCombo"
                                              Height="26"
                                              Width="130"
                                              Margin="0,0,12,0"
                                              SelectionChanged="OnSiteProgressPivotChanged" />
                                        <Button Width="110"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Content="Copy (Excel)"
                                            Click="OnSiteProgressCopyExcelClick" />
                                        <Button Width="110"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Content="Import Excel"
                                            Click="OnSiteProgressImportExcelClick" />
                                        <Button Width="110"
                                            Height="28"
                                            Content="Export Excel"
                                            Click="OnSiteProgressExportExcelClick" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="8"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Margin="12,0,12,0">
                                        <Button Width="150"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Content="Apply To Selection"
                                            Click="OnSiteProgressApplyClick" />
                                        <Button Width="120"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Content="Color 3D View"
                                            Click="OnSiteProgressColorViewClick" />
                                        <Button Width="120"
                                            Height="28"
                                            Margin="0,0,8,0"
                                            Content="Clear 3D Color"
                                            Click="OnSiteProgressClearColorViewClick" />
                                        <Button Width="90"
                                            Height="28"
                                            Content="Refresh"
                                            Click="OnSiteProgressRefreshClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Summary" Margin="0,8,0,8">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=SiteProgressSubTabControl}"
                                                 Value="2">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Structure Element:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                                <ComboBox x:Name="SiteProgressStructureFilterCombo"
                                      Grid.Column="1"
                                      Height="26"
                                      Width="200"
                                      Margin="0,0,12,0"
                                      SelectionChanged="OnSiteProgressFilterChanged" />
                                <TextBlock Grid.Column="2"
                                       Text="BuildingLevel:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                                <ComboBox x:Name="SiteProgressBuildingLevelFilterCombo"
                                      Grid.Column="3"
                                      Height="26"
                                      Width="220"
                                      Margin="0,0,12,0"
                                      SelectionChanged="OnSiteProgressFilterChanged" />
                                <TextBlock Text="Scope:"
                                       Grid.Column="5"
                                       VerticalAlignment="Center"
                                       Margin="12,0,8,0" />
                                <RadioButton x:Name="SiteProgressScopeSelectionRadio"
                                         Grid.Column="6"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Content="Selection" />
                                <RadioButton x:Name="SiteProgressScopeViewRadio"
                                         Grid.Column="7"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Content="Current View" />
                                <RadioButton x:Name="SiteProgressScopeAllRadio"
                                         Grid.Column="8"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Content="Entire Model"
                                         IsChecked="True" />
                                <TextBlock x:Name="SiteProgressSummaryText"
                                       Grid.Row="1"
                                       Grid.ColumnSpan="9"
                                       Margin="0,8,0,0"
                                       Foreground="#4B5A73"
                                       Text="Site Progress summary is ready." />
                            </Grid>
                        </GroupBox>

                        <TabControl Grid.Row="3"
                                Margin="0"
                                x:Name="SiteProgressContentTabControl"
                                SelectedIndex="{Binding SelectedIndex, ElementName=SiteProgressSubTabControl, Mode=TwoWay}">
                            <TabControl.Template>
                                <ControlTemplate TargetType="{x:Type TabControl}">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabItem Header="DETAIL PROGRESS">
                                <Grid Margin="0">
                                    <GroupBox Header="By Element + Floor" Margin="0">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid x:Name="SiteProgressCombinedGrid"
                                                  Grid.Row="0"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Extended"
                                                  SelectionChanged="OnSiteProgressGridSelectionChanged"
                                                  PreviewMouseLeftButtonDown="OnSiteProgressCombinedGridPreviewMouseLeftButtonDown"
                                                  PreviewMouseMove="OnSiteProgressCombinedGridPreviewMouseMove"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="BuildingLevel"
                                                                    Binding="{Binding BuildingLevel}"
                                                                    Width="100" />
                                                    <DataGridTextColumn Header="Structure Element"
                                                                    Binding="{Binding StructureElement}"
                                                                    Width="130" />
                                                    <DataGridTextColumn Header="Reinforcement(%)"
                                                                    Binding="{Binding SiteProgressReinforcementPercent, StringFormat={}{0:0.##}}"
                                                                    Width="105" />
                                                    <DataGridTextColumn Header="Formwork(%)"
                                                                    Binding="{Binding SiteProgressFormworkPercent, StringFormat={}{0:0.##}}"
                                                                    Width="95" />
                                                    <DataGridTextColumn Header="Volume(%)"
                                                                    Binding="{Binding SiteProgressVolumePercent, StringFormat={}{0:0.##}}"
                                                                    Width="85" />
                                                    <DataGridTextColumn Header="Status"
                                                                    Binding="{Binding Status}"
                                                                    Width="85" />
                                                    <DataGridTextColumn Header="Type"
                                                                    Binding="{Binding TypeName}"
                                                                    Width="120" />
                                                    <DataGridTextColumn Header="Elements"
                                                                    Binding="{Binding ElementCount}"
                                                                    Width="65" />
                                                    <DataGridTextColumn Header="Reinforcement(Kg)"
                                                                    Binding="{Binding ReinforcementKg, StringFormat={}{0:0.###}}"
                                                                    Width="110" />
                                                    <DataGridTextColumn Header="Formwork(m2)"
                                                                    Binding="{Binding FormworkM2, StringFormat={}{0:0.###}}"
                                                                    Width="95" />
                                                    <DataGridTextColumn Header="Volume(m3)"
                                                                    Binding="{Binding VolumeM3, StringFormat={}{0:0.###}}"
                                                                    Width="90" />
                                                    <DataGridTextColumn Header="Reinforcement Completed(Kg)"
                                                                    Binding="{Binding ReinforcementCompletedKg, StringFormat={}{0:0.###}}"
                                                                    Width="145" />
                                                    <DataGridTextColumn Header="Formwork Completed(m2)"
                                                                    Binding="{Binding FormworkCompletedM2, StringFormat={}{0:0.###}}"
                                                                    Width="130" />
                                                    <DataGridTextColumn Header="Volume Completed(m3)"
                                                                    Binding="{Binding VolumeCompletedM3, StringFormat={}{0:0.###}}"
                                                                    Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Grid.Row="1"
                                                Margin="0,6,0,0"
                                                Background="#F4F7FB"
                                                BorderBrush="#D1DAE6"
                                                BorderThickness="1"
                                                Padding="8,4">
                                                <TextBlock x:Name="SiteProgressCombinedTotalsText"
                                                       Foreground="#2D4B71"
                                                       FontWeight="SemiBold"
                                                       Text="Sum: Rows=0 | Elements=0 | Reinforcement: 0/0 Kg (0%) | Formwork: 0/0 m2 (0%) | Volume: 0/0 m3 (0%)" />
                                            </Border>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="SUMMARY PROGRESS">
                                <Grid Margin="0">
                                    <GroupBox Header="Overall Progress (By Building)" Margin="0">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid x:Name="SiteProgressByBuildingGrid"
                                                  Grid.Row="0"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Extended"
                                                  SelectionChanged="OnSiteProgressGridSelectionChanged"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="BuildingLevel"
                                                                    Binding="{Binding BuildingLevel}"
                                                                    Width="100" />
                                                    <DataGridTextColumn Header="Structure Element"
                                                                    Binding="{Binding StructureElement}"
                                                                    Width="130" />
                                                    <DataGridTextColumn Header="Reinforcement(%)"
                                                                    Binding="{Binding SiteProgressReinforcementPercent, StringFormat={}{0:0.##}}"
                                                                    Width="105" />
                                                    <DataGridTextColumn Header="Formwork(%)"
                                                                    Binding="{Binding SiteProgressFormworkPercent, StringFormat={}{0:0.##}}"
                                                                    Width="95" />
                                                    <DataGridTextColumn Header="Volume(%)"
                                                                    Binding="{Binding SiteProgressVolumePercent, StringFormat={}{0:0.##}}"
                                                                    Width="85" />
                                                    <DataGridTextColumn Header="Status"
                                                                    Binding="{Binding Status}"
                                                                    Width="85" />
                                                    <DataGridTextColumn Header="Type"
                                                                    Binding="{Binding TypeName}"
                                                                    Width="120" />
                                                    <DataGridTextColumn Header="Elements"
                                                                    Binding="{Binding ElementCount}"
                                                                    Width="65" />
                                                    <DataGridTextColumn Header="Reinforcement(Kg)"
                                                                    Binding="{Binding ReinforcementKg, StringFormat={}{0:0.###}}"
                                                                    Width="110" />
                                                    <DataGridTextColumn Header="Formwork(m2)"
                                                                    Binding="{Binding FormworkM2, StringFormat={}{0:0.###}}"
                                                                    Width="95" />
                                                    <DataGridTextColumn Header="Volume(m3)"
                                                                    Binding="{Binding VolumeM3, StringFormat={}{0:0.###}}"
                                                                    Width="90" />
                                                    <DataGridTextColumn Header="Reinforcement Completed(Kg)"
                                                                    Binding="{Binding ReinforcementCompletedKg, StringFormat={}{0:0.###}}"
                                                                    Width="145" />
                                                    <DataGridTextColumn Header="Formwork Completed(m2)"
                                                                    Binding="{Binding FormworkCompletedM2, StringFormat={}{0:0.###}}"
                                                                    Width="130" />
                                                    <DataGridTextColumn Header="Volume Completed(m3)"
                                                                    Binding="{Binding VolumeCompletedM3, StringFormat={}{0:0.###}}"
                                                                    Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Grid.Row="1"
                                                Margin="0,6,0,0"
                                                Background="#F4F7FB"
                                                BorderBrush="#D1DAE6"
                                                BorderThickness="1"
                                                Padding="8,4">
                                                <TextBlock x:Name="SiteProgressByBuildingTotalsText"
                                                       Foreground="#2D4B71"
                                                       FontWeight="SemiBold"
                                                       Text="Sum: Rows=0 | Elements=0 | Reinforcement: 0/0 Kg (0%) | Formwork: 0/0 m2 (0%) | Volume: 0/0 m3 (0%)" />
                                            </Border>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>

                            <TabItem Header="PROGRESS DASHBORD">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="SiteProgressDashboardRightGapColumn" Width="10" />
                                        <ColumnDefinition x:Name="SiteProgressDashboardRightColumn" Width="840" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0"
                                        Grid.ColumnSpan="3"
                                        Background="#F4F7FB"
                                        BorderBrush="#D1DAE6"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="8,6">
                                        <WrapPanel>
                                            <Border Background="#FFFFFF" BorderBrush="#D1DAE6" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Percent Complete" Foreground="#4B5A73" FontSize="10" />
                                                    <TextBlock x:Name="DashboardKpiPercentCompleteText" Text="0%" Foreground="#1F4E78" FontSize="14" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#D1DAE6" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Completed BOQ" Foreground="#4B5A73" FontSize="10" />
                                                    <TextBlock x:Name="DashboardKpiCompletedBoqText" Text="0" Foreground="#1F4E78" FontSize="14" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#D1DAE6" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Remaining BOQ" Foreground="#4B5A73" FontSize="10" />
                                                    <TextBlock x:Name="DashboardKpiRemainingBoqText" Text="0" Foreground="#1F4E78" FontSize="14" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#D1DAE6" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="Elements Updated" Foreground="#4B5A73" FontSize="10" />
                                                    <TextBlock x:Name="DashboardKpiElementsUpdatedText" Text="0 / 0" Foreground="#1F4E78" FontSize="14" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FFFFFF" BorderBrush="#D1DAE6" BorderThickness="1" CornerRadius="2" Padding="8,4">
                                                <StackPanel>
                                                    <TextBlock Text="Last Refresh" Foreground="#4B5A73" FontSize="10" />
                                                    <TextBlock x:Name="DashboardKpiLastRefreshText" Text="--" Foreground="#1F4E78" FontSize="14" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </Border>

                                    <GroupBox Grid.Row="2" Grid.Column="0" Grid.RowSpan="3" Header="Column Chart">
                                        <Grid Margin="10"
                                          VerticalAlignment="Top">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <DockPanel Margin="0,0,0,6"
                                                       LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal">
                                                        <CheckBox x:Name="SiteProgressDashboardFocusChartToggle"
                                                              Margin="0,0,10,0"
                                                              VerticalAlignment="Center"
                                                              Content="Focus Chart"
                                                              Checked="OnSiteProgressDashboardFocusChartChanged"
                                                              Unchecked="OnSiteProgressDashboardFocusChartChanged" />
                                                        <Button Width="90"
                                                            Height="24"
                                                            Margin="0,0,0,0"
                                                            Content="Refresh"
                                                            Click="OnSiteProgressRefreshClick" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="14" Height="14" Fill="#2F75B5" />
                                                        <TextBlock Text="Total BOQ" Margin="6,0,14,0" VerticalAlignment="Center" />
                                                        <Rectangle Width="14" Height="14" Fill="#5B9BD5" />
                                                        <TextBlock Text="Completed BOQ" Margin="6,0,14,0" VerticalAlignment="Center" />
                                                        <Rectangle Width="14" Height="14" Fill="#C0504D" />
                                                        <TextBlock Text="Remaining BOQ" Margin="6,0,14,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="DashboardOverallSummaryText"
                                                               Margin="12,0,0,0"
                                                               Foreground="#2D4B71"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Text="Overall: 0/0 (0%)" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <TextBlock x:Name="SiteProgressDashboardContextText"
                                                       Margin="0,0,0,6"
                                                       Foreground="#4B5A73"
                                                       Text="Scope: Entire Model | Pivot: Floor + Element | Metric: Volume(%) | Filters: Structure=All, Building=All" />

                                                <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,6"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Value"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                    <ComboBox x:Name="SiteProgressDashboardValueModeCombo"
                                                          Width="130"
                                                          Height="24"
                                                          Margin="0,0,10,0"
                                                          SelectionChanged="OnSiteProgressDashboardValueModeChanged" />
                                                    <TextBlock Text="Sort: Remaining Desc"
                                                           VerticalAlignment="Center"
                                                           Foreground="#4B5A73"
                                                           Margin="0,0,12,0" />

                                                    <TextBlock Text="Zoom X"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                    <Slider x:Name="SiteProgressDashboardZoomXSlider"
                                                        Width="120"
                                                        Minimum="0.5"
                                                        Maximum="3.0"
                                                        Value="1.0"
                                                        SmallChange="0.1"
                                                        LargeChange="0.25"
                                                        TickFrequency="0.1"
                                                        IsSnapToTickEnabled="False"
                                                        ValueChanged="OnSiteProgressDashboardZoomChanged" />
                                                    <TextBlock x:Name="SiteProgressDashboardZoomXText"
                                                           Width="46"
                                                           Margin="6,0,12,0"
                                                           VerticalAlignment="Center"
                                                           Text="100%" />

                                                    <TextBlock Text="Zoom Y"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                    <Slider x:Name="SiteProgressDashboardZoomYSlider"
                                                        Width="120"
                                                        Minimum="0.5"
                                                        Maximum="3.0"
                                                        Value="1.0"
                                                        SmallChange="0.1"
                                                        LargeChange="0.25"
                                                        TickFrequency="0.1"
                                                        IsSnapToTickEnabled="False"
                                                        ValueChanged="OnSiteProgressDashboardZoomChanged" />
                                                    <TextBlock x:Name="SiteProgressDashboardZoomYText"
                                                           Width="46"
                                                           Margin="6,0,12,0"
                                                           VerticalAlignment="Center"
                                                           Text="100%" />

                                                    <Button Width="90"
                                                        Height="24"
                                                        Content="Reset Zoom"
                                                        Click="OnSiteProgressDashboardResetZoomClick" />
                                                    <TextBlock Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#4B5A73"
                                                           Text="Wheel in plot: XY | near bottom axis: X | near left axis: Y" />
                                                </StackPanel>

                                                <ScrollViewer x:Name="SiteProgressDashboardChartScrollViewer"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          CanContentScroll="False"
                                                          PanningMode="Both"
                                                          Height="420"
                                                          PreviewMouseWheel="OnSiteProgressDashboardChartPreviewMouseWheel">
                                                    <Border x:Name="SiteProgressDashboardChartZoomHost"
                                                        MinHeight="420"
                                                        HorizontalAlignment="Left">
                                                        <Border.LayoutTransform>
                                                            <ScaleTransform x:Name="SiteProgressDashboardChartScaleTransform"
                                                                        ScaleX="1.0"
                                                                        ScaleY="1.0" />
                                                        </Border.LayoutTransform>
                                                        <oxy:PlotView x:Name="SiteProgressDashboardPlotView"
                                                                  Width="900"
                                                                  Height="420"
                                                                  Background="#F8FAFD" />
                                                    </Border>
                                                </ScrollViewer>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1"
                                                   Foreground="#4B5A73"
                                                   Text="Chart values are based on current Summary scope and filters."
                                                   Margin="0,6,0,0" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox x:Name="SiteProgressDashboardDonutGroup" Grid.Row="2" Grid.Column="2" Header="Doughnut Chart" MinWidth="820">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" MinHeight="220">
                                                <oxy:PlotView x:Name="SiteProgressDashboardDonutPlotView"
                                                          Background="#F8FAFD" />
                                                <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False">
                                                    <TextBlock x:Name="DashboardDonutCenterPercentText"
                                                           Text="0%"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center" />
                                                    <TextBlock Text="Complete"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#4B5A73" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,8,0,0">
                                                <Rectangle x:Name="DashboardLegendCompletedSwatch" Width="14" Height="14" Fill="#5B9BD5" />
                                                <TextBlock x:Name="DashboardLegendCompletedText"
                                                       Margin="6,0,16,0"
                                                       VerticalAlignment="Center"
                                                       Text="Complete: 0" />
                                                <Rectangle x:Name="DashboardLegendRemainingSwatch" Width="14" Height="14" Fill="#D9E1F2" />
                                                <TextBlock x:Name="DashboardLegendRemainingText"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="Remaining: 0" />
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox x:Name="SiteProgressDashboardTableGroup" Grid.Row="4" Grid.Column="2" Header="Structure Summary Table" MinWidth="820">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid x:Name="SiteProgressDashboardStructureGrid"
                                                  Grid.Row="0"
                                                  Width="822"
                                                  HorizontalAlignment="Left"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeColumns="False"
                                                  CanUserReorderColumns="False"
                                                  RowHeaderWidth="0"
                                                  RowBackground="#FFFFFF"
                                                  AlternatingRowBackground="#F8FBFF"
                                                  AlternationCount="2"
                                                  SelectionMode="Extended"
                                                  SelectionChanged="OnSiteProgressDashboardStructureSelectionChanged"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="All">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Structure Element"
                                                                    Binding="{Binding StructureElement}"
                                                                    Width="155" />
                                                    <DataGridTextColumn Header="Elements"
                                                                    Binding="{Binding ElementCount}"
                                                                    Width="70" />
                                                    <DataGridTextColumn Header="Total BOQ"
                                                                    Binding="{Binding TotalBoq, StringFormat={}{0:0.###}}"
                                                                    Width="110" />
                                                    <DataGridTextColumn Header="Completed BOQ"
                                                                    Binding="{Binding CompletedBoq, StringFormat={}{0:0.###}}"
                                                                    Width="105" />
                                                    <DataGridTextColumn Header="Remaining BOQ"
                                                                    Binding="{Binding RemainingBoq, StringFormat={}{0:0.###}}"
                                                                    Width="115" />
                                                    <DataGridTemplateColumn Header="Progress Work (%)"
                                                                        Width="120">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="3,0">
                                                                    <ProgressBar Minimum="0"
                                                                             Maximum="100"
                                                                             Value="{Binding ProgressPercent}"
                                                                             Height="15"
                                                                             Background="#E7EEF8"
                                                                             BorderBrush="#C7D6EA"
                                                                             BorderThickness="1">
                                                                        <ProgressBar.Style>
                                                                            <Style TargetType="ProgressBar">
                                                                                <Setter Property="Foreground" Value="#8EA6C7" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                                        <Setter Property="Foreground" Value="#2E8B57" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="In Progress">
                                                                                        <Setter Property="Foreground" Value="#E08C2E" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Status}" Value="Not Started">
                                                                                        <Setter Property="Foreground" Value="#8EA6C7" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ProgressBar.Style>
                                                                    </ProgressBar>
                                                                    <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0.##}%}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#24486F" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Status"
                                                                        Width="95">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource DashboardStatusBadgeBorderStyle}"
                                                                    Padding="6,2"
                                                                    Margin="3,1"
                                                                    HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Status}"
                                                                           Style="{StaticResource DashboardStatusBadgeTextStyle}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Border Grid.Row="1"
                                                Width="822"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0"
                                                Background="#F4F7FB"
                                                BorderBrush="#D1DAE6"
                                                BorderThickness="1"
                                                Padding="8,4">
                                                <TextBlock x:Name="SiteProgressDashboardTotalsText"
                                                       Foreground="#2D4B71"
                                                       FontWeight="SemiBold"
                                                       Text="Sum: Rows=0 | Elements=0 | Total BOQ=0 | Completed BOQ=0 | Remaining BOQ=0 | Progress=0%" />
                                            </Border>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <TabItem Header="POWER BI TOOL">
                    <Grid Margin="12">
                        <GroupBox Header="Power BI Control Center" Margin="0">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                    Background="#F4F7FB"
                                    BorderBrush="#D1DAE6"
                                    BorderThickness="1"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Publish, refresh, and validate Power BI model inputs from Revit data."
                                               FontSize="13"
                                               Foreground="#4B5A73"
                                               Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                   Text="Report URL:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                            <TextBox x:Name="PowerBiReportUrlTextBox"
                                                 Grid.Column="1"
                                                 Height="28"
                                                 Margin="0,0,8,0"
                                                 VerticalContentAlignment="Center"
                                                 Text="https://app.powerbi.com/" />
                                            <Button Grid.Column="2"
                                                Width="105"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Content="Open Report"
                                                Click="OnOpenPowerBiReportClick" />
                                            <Button Grid.Column="3"
                                                Width="95"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Content="Copy URL"
                                                Click="OnCopyPowerBiReportUrlClick" />
                                            <Button Grid.Column="4"
                                                Width="95"
                                                Height="28"
                                                Content="Default URL"
                                                Click="OnResetPowerBiReportUrlClick" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1"
                                  Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0"
                                          Header="Pipeline Actions"
                                          Margin="0">
                                        <WrapPanel Margin="8">
                                            <Button Style="{StaticResource PrimaryActionButton}"
                                                Width="220"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Refresh Revit -> Excel -> Power BI"
                                                Click="OnPowerBiRefreshPipelineClick" />
                                            <Button Style="{StaticResource PrimaryActionButton}"
                                                Width="230"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="One-click Refresh + Open Power BI"
                                                Click="OnPowerBiRefreshAndOpenClick" />
                                            <Button Width="195"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Export Data Model (CSV)"
                                                Click="OnPowerBiExportDataClick" />
                                            <Button Width="210"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Export Revit -> MSP Package"
                                                Click="OnExportMsProjectPackageClick" />
                                            <Button Width="170"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Summary All Elements"
                                                Click="OnPowerBiSummaryAllElementsClick" />
                                            <Button Width="210"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Import MSP Progress (CSV)"
                                                Click="OnImportMsProjectProgressClick" />
                                        </WrapPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="2"
                                          Header="Workspace Actions"
                                          Margin="0">
                                        <WrapPanel Margin="8">
                                            <Button Width="150"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Open Export Folder"
                                                Click="OnOpenPowerBiExportFolderClick" />
                                            <Button Width="150"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Open PBIP File"
                                                Click="OnOpenPowerBiProjectFileClick" />
                                            <Button Width="180"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Open MHNK Dashboard"
                                                Click="OnOpenMsProjectDashboardClick" />
                                            <Button Width="150"
                                                Height="30"
                                                Margin="0,0,8,8"
                                                Content="Refresh Workspace Info"
                                                Click="OnPowerBiRefreshInfoClick" />
                                        </WrapPanel>
                                    </GroupBox>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0"
                                          Header="Activity Log"
                                          Margin="0">
                                        <Border Margin="8"
                                            Background="#F4F7FB"
                                            BorderBrush="#D1DAE6"
                                            BorderThickness="1"
                                            Padding="8,6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="PowerBiExportSummaryText"
                                                       Foreground="#2D4B71"
                                                       TextWrapping="Wrap"
                                                       Text="Ready. Export creates fact/dim CSV files for Power BI model import." />
                                            </ScrollViewer>
                                        </Border>
                                    </GroupBox>

                                    <GroupBox Grid.Column="2"
                                          Header="Runtime Info"
                                          Margin="0">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Project File:"
                                                   Margin="0,0,8,6"
                                                   Foreground="#4B5A73" />
                                            <TextBlock x:Name="PowerBiProjectPathText"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"
                                                   Foreground="#1F4E79" />

                                            <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Export Folder:"
                                                   Margin="0,0,8,6"
                                                   Foreground="#4B5A73" />
                                            <TextBlock x:Name="PowerBiExportFolderText"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"
                                                   Foreground="#1F4E79" />

                                            <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Site Refresh:"
                                                   Margin="0,0,8,6"
                                                   Foreground="#4B5A73" />
                                            <TextBlock x:Name="PowerBiSiteProgressRefreshText"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"
                                                   Foreground="#1F4E79" />

                                            <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Data Health:"
                                                   Margin="0,0,8,6"
                                                   Foreground="#4B5A73" />
                                            <TextBlock x:Name="PowerBiDataHealthText"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"
                                                   Foreground="#1F4E79" />

                                            <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="Last Action:"
                                                   Margin="0,0,8,0"
                                                   Foreground="#4B5A73" />
                                            <TextBlock x:Name="PowerBiLastActionText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   TextWrapping="Wrap"
                                                   Foreground="#1F4E79" />
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
                <TabItem Header="PM DASHBOARD">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                               Margin="0,0,0,8"
                               LastChildFill="False">
                            <CheckBox x:Name="PmDashboardMultiSubTabCheck"
                                  Content="Open Many Sub-Tabs"
                                  VerticalAlignment="Center"
                                  Checked="OnPmDashboardMultiSubTabCheckChanged"
                                  Unchecked="OnPmDashboardMultiSubTabCheckChanged" />
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <TabControl x:Name="PmDashboardSubTabControl">
                                <TabControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </TabControl.ItemsPanel>
                                <TabItem Header="Quick Actions">
                                    <Border Style="{StaticResource PmDashCardBorder}"
                                    Margin="8">
                                        <TextBlock Style="{StaticResource PmDashMutedText}"
                                           Text="Use Refresh Data to sync the latest Revit + Site Progress + active MS Project data." />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Planning"
                                 Visibility="Collapsed">
                                    <Border Style="{StaticResource PmDashCardBorder}"
                                    Margin="8">
                                        <TextBlock Style="{StaticResource PmDashMutedText}"
                                           Text="Planning analytics are available directly in this PM Dashboard tab." />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Progress"
                                 Visibility="Collapsed">
                                    <Border Style="{StaticResource PmDashCardBorder}"
                                    Margin="8">
                                        <TextBlock Style="{StaticResource PmDashMutedText}"
                                           Text="Progress sync is integrated with Site Progress and active MS Project package refresh." />
                                    </Border>
                                </TabItem>
                                <TabItem Header="Update Progress">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0"
                                           Margin="0,0,0,8"
                                           LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                                <Button Width="150"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Content="Apply To MS Project"
                                                Click="OnPmUpdateProgressApplyToMsProjectClick" />
                                                <Button Width="120"
                                                Height="28"
                                                Content="Refresh Data"
                                                Click="OnPmUpdateProgressRefreshClick" />
                                            </StackPanel>

                                            <Button x:Name="PmUpdateProgressColumnsButton"
                                            Content="Columns v"
                                            Padding="10,4"
                                            MinWidth="110"
                                            Click="OnPmUpdateProgressColumnsButtonClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu x:Name="PmUpdateProgressColumnsMenu"
                                                         Opened="OnPmUpdateProgressColumnsMenuOpened" />
                                                </Button.ContextMenu>
                                            </Button>

                                            <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#4B5A73"
                                               Text="Live MS Project tasks and earned-value fields for Revit progress update workflow." />
                                        </DockPanel>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="1.95*" />
                                            </Grid.ColumnDefinitions>

                                            <GroupBox Grid.Column="0"
                                              Header="DETAIL PROGRESS (from Site Progress)"
                                              Margin="0,0,8,0">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                       Margin="2,0,2,6"
                                                       Foreground="#4B5A73"
                                                       Text="Ctrl+C/Ctrl+V supports single cell, multi-cells, rows, and columns. Drag from Detail Progress to MS Project table: row drop maps by task, cell block drop pastes by position." />

                                                    <WrapPanel Grid.Row="1"
                                                       Margin="2,0,2,6"
                                                       VerticalAlignment="Center">
                                                        <TextBlock Text="BuildingLevel:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                        <ComboBox x:Name="PmDetailProgressBuildingLevelFilterCombo"
                                                          Width="140"
                                                          Height="26"
                                                          Margin="0,0,14,0"
                                                          IsEditable="True"
                                                          IsReadOnly="True"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          ItemTemplate="{StaticResource PmUpdateProgressMultiSelectFilterItemTemplate}"
                                                          ItemContainerStyle="{StaticResource PmUpdateProgressMultiSelectComboItemStyle}"
                                                          SelectionChanged="OnPmDetailProgressFilterChanged" />
                                                        <TextBlock Text="Structure Element:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                        <ComboBox x:Name="PmDetailProgressStructureElementFilterCombo"
                                                          Width="170"
                                                          Height="26"
                                                          Margin="0,0,14,0"
                                                          IsEditable="True"
                                                          IsReadOnly="True"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          ItemTemplate="{StaticResource PmUpdateProgressMultiSelectFilterItemTemplate}"
                                                          ItemContainerStyle="{StaticResource PmUpdateProgressMultiSelectComboItemStyle}"
                                                          SelectionChanged="OnPmDetailProgressFilterChanged" />
                                                        <TextBlock Text="Structure Type:"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                        <ComboBox x:Name="PmDetailProgressStructureTypeFilterCombo"
                                                          Width="170"
                                                          Height="26"
                                                          IsEditable="True"
                                                          IsReadOnly="True"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"

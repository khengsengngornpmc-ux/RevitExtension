                                                                             IsReadOnly="{Binding IsValueReadOnly}"
                                                                             Style="{StaticResource TasAttributeEditorTextBoxStyle}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellEditingTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Add" Width="54">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding Add, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

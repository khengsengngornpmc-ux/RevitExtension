                                                 Text="(not selected)" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                          Header="Step 2: Scope"
                                          Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal"
                                                Margin="8">
                                            <RadioButton x:Name="LinksheetWholeModelRadio"
                                                     Content="Whole Model"
                                                     IsChecked="True"
                                                     Margin="0,0,14,0"
                                                     Checked="OnLinksheetScopeChanged" />
                                            <RadioButton x:Name="LinksheetActiveViewRadio"
                                                     Content="Active View"
                                                     Margin="0,0,14,0"
                                                     Checked="OnLinksheetScopeChanged" />
                                            <RadioButton x:Name="LinksheetCurrentSelectionRadio"
                                                     Content="Current Selection"
                                                     Checked="OnLinksheetScopeChanged" />
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1" x:Name="LinksheetSubTabControl">
                            <TabItem Header="Model Categories">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Whole Model" IsChecked="True" Margin="0,0,12,0" />
                                            <RadioButton Content="Active View" Margin="0,0,12,0" />
                                            <RadioButton Content="Current Selection" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Width="220" Height="24" Text="Completed" Margin="0,0,6,0" />
                                            <TextBox Width="50" Height="24" Text="0%" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <GroupBox Grid.Row="0" Grid.Column="0" Header="Select Categories" Margin="0,0,8,8">
                                            <StackPanel Margin="8">
                                                <ComboBox Height="26" Margin="0,0,0,6">
                                                    <ComboBoxItem>All Disciplines</ComboBoxItem>
                                                </ComboBox>
                                                <TextBox Height="24" Text="Search" />

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F7FE" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F0FD" />
                    <Setter Property="Foreground" Value="#1F6FBF" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TasTreeCategoryItem" TargetType="TreeViewItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Padding" Value="0,5" />
        </Style>
        <Style x:Key="TasTreeElementItem" TargetType="TreeViewItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Padding" Value="0,5" />
        </Style>
        <Style x:Key="DashboardStatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF3F8" />
            <Setter Property="BorderBrush" Value="#C9D5E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="#E6F7EE" />
                    <Setter Property="BorderBrush" Value="#9FD1B2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="In Progress">
                    <Setter Property="Background" Value="#FFF4E5" />
                    <Setter Property="BorderBrush" Value="#F3C58B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Not Started">
                    <Setter Property="Background" Value="#F2F4F8" />
                    <Setter Property="BorderBrush" Value="#D3DBE7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardStatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A4A5F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#1E7A46" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="In Progress">
                    <Setter Property="Foreground" Value="#A86108" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Not Started">
                    <Setter Property="Foreground" Value="#5E6A7A" />
                </DataTrigger>

                                                    <ComboBox x:Name="PlanVsActualTargetCompleteFilterCombo" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </GroupBox>

                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>

                                            <ScrollViewer Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <Border Background="#9CC2E5"
                                                        BorderBrush="#4A90E2"
                                                        BorderThickness="1"
                                                        Padding="4,2">
                                                        <TextBlock Text="MONTHLY PLAN TO COMPLETE"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center" />
                                                    </Border>
                                                    <DataGrid x:Name="PlanVsActualPlanDataGrid"
                                                          Margin="0,0,0,10"
                                                          AutoGenerateColumns="True"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          GridLinesVisibility="All"
                                                          AlternatingRowBackground="#EEF5FF"
                                                          ColumnHeaderStyle="{StaticResource BoreyProjectSummaryHeaderStyle}"
                                                          SelectionUnit="CellOrRowHeader"
                                                          SelectionMode="Extended"
                                                          ClipboardCopyMode="IncludeHeader"
                                                          EnableRowVirtualization="True"
                                                          EnableColumnVirtualization="True"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          ScrollViewer.CanContentScroll="True"
                                                          PreviewKeyDown="OnBoreyGridPreviewKeyDown" />

                                                    <Border Background="#9CC2E5"
                                                        BorderBrush="#4A90E2"
                                                        BorderThickness="1"
                                                        Padding="4,2">
                                                        <TextBlock Text="ACTUAL COMPLETED"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center" />
                                                    </Border>
                                                    <DataGrid x:Name="PlanVsActualActualDataGrid"
                                                          Margin="0,0,0,10"
                                                          AutoGenerateColumns="True"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          GridLinesVisibility="All"
                                                          AlternatingRowBackground="#EEF5FF"
                                                          ColumnHeaderStyle="{StaticResource BoreyProjectSummaryHeaderStyle}"
                                                          SelectionUnit="CellOrRowHeader"
                                                          SelectionMode="Extended"
                                                          ClipboardCopyMode="IncludeHeader"
                                                          EnableRowVirtualization="True"
                                                          EnableColumnVirtualization="True"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          ScrollViewer.CanContentScroll="True"
                                                          PreviewKeyDown="OnBoreyGridPreviewKeyDown" />

                                                    <Border Background="#9CC2E5"
                                                        BorderBrush="#4A90E2"
                                                        BorderThickness="1"
                                                        Padding="4,2">
                                                        <TextBlock Text="REMAINING TO COMPLETE"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center" />
                                                    </Border>
                                                    <DataGrid x:Name="PlanVsActualRemainingDataGrid"
                                                          AutoGenerateColumns="True"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          GridLinesVisibility="All"
                                                          AlternatingRowBackground="#EEF5FF"
                                                          ColumnHeaderStyle="{StaticResource BoreyProjectSummaryHeaderStyle}"
                                                          SelectionUnit="CellOrRowHeader"
                                                          SelectionMode="Extended"
                                                          ClipboardCopyMode="IncludeHeader"
                                                          EnableRowVirtualization="True"
                                                          EnableColumnVirtualization="True"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          ScrollViewer.CanContentScroll="True"
                                                          PreviewKeyDown="OnBoreyGridPreviewKeyDown" />
                                                </StackPanel>
                                            </ScrollViewer>

                                            <GroupBox Grid.Column="1"
                                                  Header="COLUMN CHART (PLAN / ACTUAL / REMAINING)"
                                                  Margin="10,0,0,0">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock x:Name="PlanVsActualChartScopeText"
                                                           Text="Months: 0 | Plan: 0 | Actual: 0 | Remaining: 0"
                                                           Foreground="#4B5A73" />
                                                    <Border Grid.Row="1"
                                                        Margin="0,6,0,0"
                                                        BorderBrush="#D1DAE6"
                                                        BorderThickness="1"
                                                        Background="White">
                                                        <oxy:PlotView x:Name="PlanVsActualColumnPlotView" />
                                                    </Border>
                                                </Grid>
                                            </GroupBox>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="SUBCONTRACTOR">
                                    <Grid Margin="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <GroupBox Header="Filter" Grid.Row="0">
                                                <UniformGrid Rows="1" Columns="6" Margin="8">
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="ZONE" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="SubcontractorZoneFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="BLOCK" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="SubcontractorBlockFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="SUB-BLOCK" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="SubcontractorSubBlockFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="HOUSE-TYPE" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="SubcontractorHouseTypeFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="HOUSE ID" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="SubcontractorHouseIdFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="SUBCONTRACTOR" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="SubcontractorNameFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="HANDOVER STATUS" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="SubcontractorHandoverStatusFilterCombo" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </GroupBox>
                                            <DataGrid x:Name="SubcontractorDataGrid"
                                                  Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  AutoGenerateColumns="True"
                                                  IsReadOnly="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  SelectionUnit="CellOrRowHeader"
                                                  SelectionMode="Extended"
                                                  ClipboardCopyMode="IncludeHeader"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  PreviewKeyDown="OnBoreyGridPreviewKeyDown" />
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="CONTRACT/LOA/BLC No.">
                                    <Grid Margin="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <GroupBox Header="Filter" Grid.Row="0">
                                                <UniformGrid Rows="1" Columns="6" Margin="8">
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="ZONE" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="ContractLoaBlcZoneFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="BLOCK" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="ContractLoaBlcBlockFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="SUB-BLOCK" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="ContractLoaBlcSubBlockFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="HOUSE-TYPE" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="ContractLoaBlcHouseTypeFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="HOUSE ID" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="ContractLoaBlcHouseIdFilterCombo" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="HANDOVER STATUS" Margin="0,0,0,4" />
                                                        <ComboBox x:Name="ContractLoaBlcHandoverStatusFilterCombo" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </GroupBox>
                                            <DataGrid x:Name="ContractLoaBlcDataGrid"
                                                  Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  AutoGenerateColumns="True"
                                                  IsReadOnly="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  SelectionUnit="CellOrRowHeader"
                                                  SelectionMode="Extended"
                                                  ClipboardCopyMode="IncludeHeader"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  PreviewKeyDown="OnBoreyGridPreviewKeyDown" />
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="HANDOVER">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <GroupBox Header="Filter" Grid.Row="0">
                                            <UniformGrid Rows="1" Columns="6" Margin="8">
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="ZONE" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="HandoverZoneFilterCombo" />
                                                </StackPanel>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="BLOCK" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="HandoverBlockFilterCombo" />
                                                </StackPanel>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="SUB-BLOCK" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="HandoverSubBlockFilterCombo" />
                                                </StackPanel>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="HOUSE-TYPE" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="HandoverHouseTypeFilterCombo" />
                                                </StackPanel>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="HOUSE ID" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="HandoverHouseIdFilterCombo" />
                                                </StackPanel>
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="HANDOVERED STATUS" Margin="0,0,0,4" />
                                                    <ComboBox x:Name="HandoverStatusFilterCombo" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </GroupBox>
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <DataGrid x:Name="HandoverDataGrid"
                                                  Grid.Column="0"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="False"
                                                  CanUserAddRows="True"
                                                  CanUserDeleteRows="True"
                                                  SelectionUnit="CellOrRowHeader"
                                                  SelectionMode="Extended"
                                                  ClipboardCopyMode="IncludeHeader"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  PreviewKeyDown="OnBoreyGridPreviewKeyDown">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="CodeItem" SortMemberPath="Code_Item" Width="140"
                                                                    Binding="{Binding [Code_Item], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="ZONE" SortMemberPath="ZONE" Width="60"
                                                                    Binding="{Binding [ZONE], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="BLOCK" SortMemberPath="BLOCK" Width="60"
                                                                    Binding="{Binding [BLOCK], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="SUB-BLOCK" SortMemberPath="SUB-BLOCK" Width="85"
                                                                    Binding="{Binding [SUB-BLOCK], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="HOUSE-TYPE" SortMemberPath="HOUSE-TYPE" Width="90"
                                                                    Binding="{Binding [HOUSE-TYPE], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="HOUSE ID" SortMemberPath="HOUSE ID" Width="80"
                                                                    Binding="{Binding [HOUSE ID], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="House-Units" SortMemberPath="House-Units" Width="95"
                                                                    Binding="{Binding [House-Units], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="Handovered-Units" SortMemberPath="Handovered-Units" Width="120"
                                                                    Binding="{Binding [Handovered-Units], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="HANDOVERED" SortMemberPath="HANDOVERED" Width="95"
                                                                    Binding="{Binding [HANDOVERED], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <DataGridTextColumn Header="HANDOVERED STATUS" SortMemberPath="HANDOVERED STATUS" Width="140"
                                                                    Binding="{Binding [HANDOVERED STATUS], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <GroupBox Grid.Column="1"
                                                  Header="COLUMN CHART (HOUSE-UNITS / HANDOVERED-UNITS)"
                                                  Margin="10,0,0,0">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="HandoverChartScopeText"
                                                           Text="Statuses: 0 | House-Units: 0 | Handovered-Units: 0"
                                                           Foreground="#4B5A73" />
                                                    <Border Grid.Row="1"
                                                        Margin="0,6,0,0"
                                                        BorderBrush="#D1DAE6"
                                                        BorderThickness="1"
                                                        Background="White">
                                                        <oxy:PlotView x:Name="HandoverColumnPlotView" />
                                                    </Border>
                                                </Grid>
                                            </GroupBox>
                                        </Grid>
                                        <TextBlock x:Name="HandoverCountText"
                                               Grid.Row="2"
                                               Margin="0,6,0,0"
                                               Foreground="#4B5A73"
                                               Text="Count: 0" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#D8E1EC"
                BorderThickness="0,1,0,0"
                Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#334155"
                           FontSize="12.5"
                           Text="Ready." />
                <Button Grid.Column="1"
                        Style="{StaticResource FooterActionButtonHideInDrawing}"
                        Width="120"
                        Height="34"
                        Margin="8,0,8,0"
                        Content="Clear Filters"
                        Click="OnClearBoreyFiltersClick" />
                <Button Grid.Column="2"
                        Style="{StaticResource FooterActionButtonHideInDrawing}"
                        Width="130"
                        Height="34"
                        Margin="8,0,8,0"
                        Content="Import Excel"
                        Click="OnImportExcelClick" />
                <Button Grid.Column="3"
                        Style="{StaticResource FooterActionButtonHideInDrawing}"
                        Width="130"
                        Height="34"
                        Margin="8,0,8,0"
                        Content="Export to Excel"
                        Click="OnExportExcelClick" />
                <Button Grid.Column="4"
                        Style="{StaticResource FooterActionButtonHideInDrawing}"
                        Width="120"
                        Height="34"
                        Background="#1F6FBF"
                        Foreground="White"
                        BorderBrush="#155A9D"
                        Margin="8,0,8,0"
                        Content="Generate"
                        Click="OnGenerateClick" />
                <Button Grid.Column="5"
                        Style="{StaticResource FooterActionButtonHideInDrawing}"
                        Width="90"
                        Height="34"
                        Content="Close"
                        Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>












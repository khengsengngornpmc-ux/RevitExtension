                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Width="220" Height="24" Text="Completed" Margin="0,0,6,0" />
                                            <TextBox Width="50" Height="24" Text="0%" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>

                                        <GroupBox Grid.Column="0" Header="Categories" Margin="0,0,8,0">

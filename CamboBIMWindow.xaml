                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Total Volume (m3):" VerticalAlignment="Center" />
                                                    <TextBox x:Name="SoilExcavationVolumeTextBox"
                                                     Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                     Height="26"

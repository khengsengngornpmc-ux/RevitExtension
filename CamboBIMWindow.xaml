                                                    </StackPanel>
                                                </StackPanel>
                                            </GroupBox>

                                            <GroupBox Header="Smart Tools" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" Margin="8">
                                                    <Button Width="120"
                                                    Height="26"
                                                    Content="Auto Detect"
                                                    Click="OnAutoDetectBeamsClick" />
                                                    <TextBlock Text="Auto-select layer and preview count."
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                                </StackPanel>
                                            </GroupBox>

                                            <GroupBox Header="Beam Settings" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Beam Type:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="BeamTypeCombo"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      Height="26" />
                                                    <Button Grid.Column="2"
                                                    Width="60"
                                                    Height="26"
                                                    Margin="8,0,0,0"
                                                    Content="Edit"
                                                    Click="OnEditBeamTypeClick" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Levels" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Base Level:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="BeamBaseLevelCombo"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      Height="26" />

                                                    <TextBlock Grid.Row="1" Text="Top Level:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="BeamTopLevelCombo"
                                                      Grid.Row="1"
                                                      Grid.Column="1"
                                                      Margin="8,6,0,0"
                                                      Height="26" />
                                                </Grid>
                                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem ToolTip="Slab">
                                <TabItem.Header>
                                    <StackPanel Width="74">
                                        <Border Style="{StaticResource TabHeaderIcon}">
                                            <Viewbox Style="{StaticResource IdentifyToolIconViewbox}">
                                                <Path Style="{StaticResource IdentifyToolIconPath}"
                                                      Data="{StaticResource IdentifyIconSlabGeometry}" />
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Style="{StaticResource Cad2ModelHeaderLabel}" Text="SLAB" />
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Generate CAD to Slab"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                            <TextBlock Text="Pick a CAD link, choose By Layer and select your slab outline layer, then click Generate."
                                               Margin="0,0,0,12" />

                                            <GroupBox Header="CAD Source" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Linked DWG:" VerticalAlignment="Center" />
                                                    <TextBox x:Name="LinkNameTextBox_Slab"
                                                     Grid.Column="1"
                                                     Margin="8,0,8,0"
                                                     IsReadOnly="True"
                                                     Text="(not selected)" />
                                                    <Button Grid.Column="2"
                                                    Width="120"
                                                    Height="28"
                                                    Content="Pick Link"
                                                    Click="OnPickLinkClick" />

                                                    <TextBlock Grid.Row="1" Text="Selection Mode:" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,8,0">
                                                        <RadioButton x:Name="SelectModeRadio_Slab"
                                                             Content="Select Objects"
                                                             Checked="OnSelectionModeChanged"
                                                             Margin="0,0,16,0" />
                                                        <RadioButton x:Name="LayerModeRadio_Slab"
                                                             Content="By Layer"
                                                             IsChecked="True"
                                                             Checked="OnSelectionModeChanged" />
                                                    </StackPanel>
                                                    <Button Grid.Row="1"
                                                    Grid.Column="2"
                                                    Width="120"
                                                    Height="28"
                                                    Content="Pick Objects"
                                                    Click="OnPickObjectsClick" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Layer Filter" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Slab Layer:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="LayerCombo_Slab"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       SelectionChanged="OnCad2ModelSourceSelectionChanged"
                                                       Height="26" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Slab Sections (Excel)" Margin="0,0,0,12">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Paste from Excel: Name, Thickness[mm] (used to map slab types)"
                                                       Margin="0,0,0,6" />
                                                    <DataGrid x:Name="SlabSectionGrid"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="True"
                                                      HeadersVisibility="Column"
                                                      Height="120"
                                                      Margin="0,0,0,8">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}"
                                                                        Width="*" />
                                                            <DataGridTextColumn Header="Thickness (mm)"
                                                                        Binding="{Binding ThicknessMm}"
                                                                        Width="140" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Width="90"
                                                        Height="26"
                                                        Content="Open Excel"
                                                        Click="OnOpenSlabExcelClick" />
                                                        <Button Width="80"
                                                        Height="26"
                                                        Margin="8,0,0,0"
                                                        Content="Paste"
                                                        Click="OnPasteSlabSectionsClick" />
                                                        <Button Width="80"
                                                        Height="26"
                                                        Margin="8,0,0,0"
                                                        Content="Clear"
                                                        Click="OnClearSlabSectionsClick" />
                                                        <CheckBox x:Name="UseSlabSectionsCheck"
                                                          Content="Use slab thickness on Generate"
                                                          IsChecked="True"
                                                          Margin="16,0,0,0"
                                                          VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </GroupBox>

                                            <GroupBox Header="Slab Settings" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Slab Type:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="SlabTypeCombo"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      Height="26" />
                                                    <Button Grid.Column="2"
                                                    Width="60"
                                                    Height="26"
                                                    Margin="8,0,0,0"
                                                    Content="Edit"
                                                    Click="OnEditSlabTypeClick" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Level" Margin="0,0,0,12">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Level:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="SlabLevelCombo"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      Height="26" />
                                                </Grid>
                                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="QS TOOLS">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TabControl x:Name="QsSubTabControl" Grid.Row="0" SelectionChanged="OnQsSubTabControlSelectionChanged">
                                <TabItem Header="Quick Estimate (CBIM-QS)">
                                    <GroupBox Header="Quick Estimate (CBIM-QS)" Margin="0">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                    BorderBrush="#C9D6EA"
                                    BorderThickness="1"
                                    Background="#F8FBFF"
                                    Padding="8"
                                    Margin="0,0,0,8">
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Border Style="{StaticResource InfoChipBorderStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="Scope" Style="{StaticResource InfoChipLabelStyle}" />
                                                            <TextBlock x:Name="QsScopeBadgeText" Text="Current View" Style="{StaticResource InfoChipValueStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource InfoChipBorderStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="Categories" Style="{StaticResource InfoChipLabelStyle}" />
                                                            <TextBlock x:Name="QsCategoryCountText" Text="0 selected" Style="{StaticResource InfoChipValueStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource InfoChipBorderStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="Active Rules" Style="{StaticResource InfoChipLabelStyle}" />
                                                            <TextBlock x:Name="QsActiveRulesCountText" Text="0 enabled" Style="{StaticResource InfoChipValueStyle}" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </Border>

                                            <Border Grid.Row="1" BorderBrush="#2E75B6" BorderThickness="1" Background="#F5F9FF" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Calculation Scope" FontWeight="SemiBold" Foreground="#1F4E79" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <RadioButton x:Name="QsScopeViewRadio" Content="Current View" IsChecked="True" Margin="0,0,12,0" />
                                                        <RadioButton x:Name="QsScopeSelectionRadio" Content="Current Selection" Margin="0,0,12,0" />
                                                        <RadioButton x:Name="QsScopeAllRadio" Content="Entire Model" />
                                                    </StackPanel>

                                                    <TextBlock Text="Categories" FontWeight="SemiBold" Margin="0,10,0,0" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <CheckBox x:Name="QsStructuralFramingCheck"
                                                  Content="Structural Framing"
                                                  IsChecked="True"
                                                  Margin="0,0,14,2" />
                                                        <CheckBox x:Name="QsStructuralColumnCheck"
                                                  Content="Structural Column"
                                                  IsChecked="True"
                                                  Margin="0,0,14,2" />
                                                        <CheckBox x:Name="QsStructuralWallCheck"
                                                  Content="Structural Wall"
                                                  IsChecked="True"
                                                  Margin="0,0,14,2" />
                                                        <CheckBox x:Name="QsStructuralFloorCheck"
                                                  Content="Structural Floor"
                                                  IsChecked="True"
                                                  Margin="0,0,14,2" />
                                                        <CheckBox x:Name="QsStructuralStairCheck"
                                                  Content="Structural Stair"
                                                  IsChecked="True"
                                                  Margin="0,0,14,2" />
                                                        <CheckBox x:Name="QsFoundationCheck"
                                                  Content="Foundation"
                                                  IsChecked="True"
                                                  Margin="0,0,14,2" />
                                                    </WrapPanel>
                                                    <CheckBox x:Name="QsCreateFormworkShapeCheck"
                                              Content="Create Formwork Shape (Specialty Equipment)"
                                              IsChecked="True"
                                              Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="2" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="#F5F9FF" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="8,4">
                                                        <TextBlock Text="Setting Rules" FontWeight="SemiBold" Foreground="{StaticResource TextBrushLight}" />
                                                    </Border>

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,8,6">
                                                        <Button Width="96" Height="24" Content="Expand All" Click="OnQsExpandAllRulesClick" />
                                                        <Button Width="96" Height="24" Margin="8,0,0,0" Content="Collapse All" Click="OnQsCollapseAllRulesClick" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Margin="8,0,8,8">
                                                        <Expander x:Name="QsFoundationRulesExpander" IsExpanded="False" Margin="0,0,0,6">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="FOUNDATION" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsFoundationTopCheck" Content="Calculation for upper inclination of foundation top face" IsChecked="True" />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Expander x:Name="QsColumnRulesExpander" IsExpanded="False" Margin="0,0,0,6">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="STRUCTURAL COLUMN" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsColumnSubtractBeamCheck"
                                                          Content="Subtract the area in intersecting with the Beam"
                                                          IsChecked="True" />
                                                                <CheckBox x:Name="QsColumnSubtractBeamGECheck"
                                                          Content="Subtract area in intersecting with Beams greater than or equal to Column"
                                                          IsChecked="False"
                                                          Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Expander x:Name="QsWallRulesExpander" IsExpanded="False" Margin="0,0,0,6">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="STRUCTURAL WALL" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsWallOpeningBottomCheck"
                                                          Content="Calculate bottom faces of Opening"
                                                          IsChecked="True" />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Expander x:Name="QsFramingRulesExpander" IsExpanded="True" Margin="0,0,0,6">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="STRUCTURAL FRAMING" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsBeamBottomCheck" Content="Calculate area bottom" IsChecked="True" />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Expander x:Name="QsFloorRulesExpander" IsExpanded="True">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="STRUCTURAL FLOOR" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsFloorBottomCheck" Content="Calculate area bottom" IsChecked="True" />
                                                                <CheckBox x:Name="QsFloorSubtractBeamCheck"
                                                          Content="Subtract bottom with Framing"
                                                          IsChecked="True"
                                                          Margin="0,2,0,0" />
                                                                <CheckBox x:Name="QsFloorSubtractFoundationCheck"
                                                          Content="Subtract bottom with Foundation"
                                                          IsChecked="True"
                                                          Margin="0,2,0,0" />
                                                                <CheckBox x:Name="QsFloorSubtractOthersCheck"
                                                              Content="Subtract bottom with Floor/Wall/Column/Generic Model"
                                                              IsChecked="True"
                                                              Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Expander x:Name="QsStairRulesExpander" IsExpanded="False" Margin="0,6,0,0">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="STRUCTURAL STAIR" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsStairTopCheck"
                                                          Content="Legacy top/tread stair formwork (TAS stair painting method keeps this off)"
                                                          IsChecked="False" />
                                                                <CheckBox x:Name="QsStairSubtractBeamCheck"
                                                          Content="Subtract beam intersection from stair painting/side faces"
                                                          IsChecked="True"
                                                          Margin="0,2,0,0" />
                                                                <CheckBox x:Name="QsStairSubtractOthersCheck"
                                                          Content="Subtract Foundation/Floor/Wall/Column/Generic Model intersections from stair painting/side faces"
                                                          IsChecked="True"
                                                          Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Expander x:Name="QsSoilExcavationRulesExpander" IsExpanded="False" Margin="0,6,0,0">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="SOIL EXCAVATION" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsSoilExcavationIncludeCheck"
                                                          Content="Include Soil Excavation volume (generated MHNK DirectShape) in BOQ"
                                                          IsChecked="True" />
                                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="#4B5A73"
                                                           TextWrapping="Wrap"
                                                           Text="Source: CAD2MODEL &gt; SOIL EXC. generated Generic Model DirectShape elements tagged by MHNK." />
                                                            </StackPanel>
                                                        </Expander>

                                                        <Expander x:Name="QsSoilBackfilledRulesExpander" IsExpanded="False" Margin="0,6,0,0">
                                                            <Expander.Header>
                                                                <Border Background="#1F84D1" Padding="6,4">
                                                                    <TextBlock Text="SOIL BACKFILLED" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Expander.Header>
                                                            <StackPanel Margin="10,6,10,8">
                                                                <CheckBox x:Name="QsSoilBackfilledIncludeCheck"
                                                          Content="Include Soil Backfilled volume in BOQ"
                                                          IsChecked="True" />
                                                                <CheckBox x:Name="QsSoilBackfilledSubtractStructureCheck"
                                                          Content="Deduct all intersecting structural elements from Soil Excavation volume"
                                                          IsChecked="True"
                                                          IsEnabled="False"
                                                          Margin="0,2,0,0" />
                                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="#4B5A73"
                                                           TextWrapping="Wrap"
                                                           Text="Formula: Soil Backfilled = Soil Excavation - union volume of intersecting structural Foundation/Column/Wall/Framing/Floor/Stair elements." />
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Width="140"
                                        Height="28"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Content="Export BOQ Excel"
                                        Click="OnQsExportExcelClick" />
                                                <Button Width="170"
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Content="Hide/Show Formwork Shape"
                                        Click="OnQsHideFormworkShapesClick" />
                                                <Button Width="180"
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Content="Delete Formwork Shape"
                                        Click="OnQsDeleteFormworkShapesClick" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="4" x:Name="QsSummaryText" Margin="0,0,0,8" Foreground="#5B6C8B" TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="5" Text="Shared Parameter Group: CBIM-QS" Foreground="#4B5A73" />
                                        </Grid>
                                    </GroupBox>
                                </TabItem>

                                <TabItem Header="Measurement Settings">
                                    <GroupBox Header="Measurement Settings" Margin="0">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    BorderBrush="#C9D6EA"
                                                    BorderThickness="1"
                                                    Background="#F8FBFF"
                                                    Padding="8"
                                                    Margin="0,0,0,8">
                                                <DockPanel LastChildFill="False">
                                                    <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource InfoChipBorderStyle}">
                                                            <StackPanel>
                                                                <TextBlock Text="Profile" Style="{StaticResource InfoChipLabelStyle}" />
                                                                <TextBlock x:Name="QsMeasurementProfileBadgeText" Text="MHNK Measurement Settings" Style="{StaticResource InfoChipValueStyle}" />

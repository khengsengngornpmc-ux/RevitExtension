                                            <Setter Property="BorderBrush" Value="{StaticResource FoundationNavPanelBorderBrush}" />
                                            <Setter Property="Foreground" Value="#20252B" />
                                            <Setter Property="Background" Value="{StaticResource FoundationNavPanelBackgroundBrush}" />
                                        </Style>

                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="{StaticResource FoundationNavFieldBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="{StaticResource FoundationNavFieldBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="#1F2328" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>

                                        <Style TargetType="ComboBox">
                                            <Setter Property="BorderBrush" Value="{StaticResource FoundationNavFieldBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="{StaticResource FoundationNavFieldBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="#1F2328" />
                                            <Setter Property="Padding" Value="2,0,2,0" />
                                        </Style>

                                        <Style TargetType="Button">
                                            <Setter Property="BorderBrush" Value="#A9B0B8" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#E5E5E5" />
                                            <Setter Property="Foreground" Value="#20252B" />
                                            <Setter Property="Padding" Value="8,2" />
                                        </Style>

                                        <Style x:Key="FoundationRebarCloneTabItemStyle" TargetType="{x:Type TabItem}">
                                            <Setter Property="Foreground" Value="#2A2F35" />
                                            <Setter Property="Background" Value="#E3E3E3" />
                                            <Setter Property="BorderBrush" Value="#B9BEC5" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Padding" Value="10,4" />
                                            <Setter Property="Margin" Value="0,0,2,0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type TabItem}">
                                                        <Border x:Name="TabBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter ContentSource="Header"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#9DB4CC" />
                                                                <Setter Property="Foreground" Value="#0F5B99" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F4F8" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <Style x:Key="FoundationNewCardBorderStyle" TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#B9BEC6" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#F4F4F4" />
                                            <Setter Property="Padding" Value="10" />
                                            <Setter Property="Margin" Value="0,0,0,10" />
                                            <Setter Property="CornerRadius" Value="2" />
                                        </Style>

                                        <Style x:Key="FoundationNewCardTitleTextStyle" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1F242B" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                        </Style>

                                        <Style x:Key="FoundationNewFieldLabelStyle" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2B3036" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                        </Style>

                                        <Style x:Key="FoundationNewHintTextStyle" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#5A6676" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>

                                        <Style x:Key="FoundationNaviateCloneCardBorderStyle" TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#AEB4BC" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#F3F3F3" />
                                            <Setter Property="CornerRadius" Value="2" />
                                        </Style>

                                        <Style x:Key="FoundationNaviateCloneSectionBorderStyle" TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#AEB4BC" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#F5F5F5" />
                                            <Setter Property="CornerRadius" Value="2" />
                                            <Setter Property="Padding" Value="8" />
                                            <Setter Property="Margin" Value="0,0,0,10" />
                                        </Style>

                                        <Style x:Key="FoundationNaviateImageToggleButtonStyle" TargetType="ToggleButton">
                                            <Setter Property="Width" Value="92" />
                                            <Setter Property="Height" Value="52" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="BorderBrush" Value="#AEB4BC" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#F2F2F2" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="BtnBorder"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="2"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#4A90E2" />
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#EAF2FE" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#EEF3FA" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <Style x:Key="FoundationNaviateToolButtonStyle" TargetType="Button">
                                            <Setter Property="Width" Value="28" />
                                            <Setter Property="Height" Value="28" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="BorderBrush" Value="#B6BBC2" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#E9E9E9" />
                                            <Setter Property="Foreground" Value="#5A6270" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>

                                        <Style x:Key="FoundationNaviateLayerModeButtonStyle" TargetType="Button">
                                            <Setter Property="Height" Value="26" />
                                            <Setter Property="Padding" Value="12,0" />
                                            <Setter Property="BorderBrush" Value="#AFC0D2" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#D8E5F4" />
                                            <Setter Property="Foreground" Value="#27496E" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="530" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0"
                                            Grid.ColumnSpan="3"
                                            Margin="0,0,0,8"
                                            Padding="8,5"
                                            Background="{StaticResource FoundationNavHintBackgroundBrush}"
                                            BorderBrush="{StaticResource FoundationNavHintBorderBrush}"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="FoundationRebarWorkflowHintText"
                                                   Foreground="#1E252C"
                                                   Text="Easy workflow: Pick foundation -> Update Preview -> Adjust dynamic parameters (mm / NxL / factor*L) -> Generate Rebar." />
                                    </Border>

                                    <GroupBox Grid.Row="1" Grid.Column="0" Header="Preview" Margin="0,0,0,8" Visibility="Collapsed">
                                        <Grid Margin="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#B8C6DC" BorderThickness="1" Background="#F7F8FA">
                                                <Viewport3D x:Name="FoundationRebarPreviewViewport"
                                                            ClipToBounds="True"
                                                            MouseLeftButtonDown="OnFoundationRebarPreviewViewportMouseLeftButtonDown"
                                                            MouseMove="OnFoundationRebarPreviewViewportMouseMove"
                                                            MouseLeftButtonUp="OnFoundationRebarPreviewViewportMouseLeftButtonUp"
                                                            MouseWheel="OnFoundationRebarPreviewViewportMouseWheel"
                                                            SizeChanged="OnFoundationRebarPreviewSurfaceSizeChanged" />
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="#B8C6DC" BorderThickness="1" Background="#F7F8FA">
                                                <Canvas x:Name="FoundationRebarPlanCanvas"
                                                        Background="Transparent"
                                                        MouseLeftButtonDown="OnFoundationRebarPreviewCanvasMouseLeftButtonDown"
                                                        MouseMove="OnFoundationRebarPreviewCanvasMouseMove"
                                                        MouseLeftButtonUp="OnFoundationRebarPreviewCanvasMouseLeftButtonUp"
                                                        MouseLeave="OnFoundationRebarPreviewCanvasMouseLeave"
                                                        MouseWheel="OnFoundationRebarPreviewCanvasMouseWheel"
                                                        SizeChanged="OnFoundationRebarPreviewSurfaceSizeChanged" />
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="0" BorderBrush="#B8C6DC" BorderThickness="1" Background="#F7F8FA">
                                                <Canvas x:Name="FoundationRebarSectionACanvas"
                                                        Background="Transparent"
                                                        MouseLeftButtonDown="OnFoundationRebarPreviewCanvasMouseLeftButtonDown"
                                                        MouseMove="OnFoundationRebarPreviewCanvasMouseMove"
                                                        MouseLeftButtonUp="OnFoundationRebarPreviewCanvasMouseLeftButtonUp"
                                                        MouseLeave="OnFoundationRebarPreviewCanvasMouseLeave"
                                                        MouseWheel="OnFoundationRebarPreviewCanvasMouseWheel"
                                                        SizeChanged="OnFoundationRebarPreviewSurfaceSizeChanged" />
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="2" BorderBrush="#B8C6DC" BorderThickness="1" Background="#F7F8FA">
                                                <Canvas x:Name="FoundationRebarSectionBCanvas"
                                                        Background="Transparent"
                                                        MouseLeftButtonDown="OnFoundationRebarPreviewCanvasMouseLeftButtonDown"
                                                        MouseMove="OnFoundationRebarPreviewCanvasMouseMove"
                                                        MouseLeftButtonUp="OnFoundationRebarPreviewCanvasMouseLeftButtonUp"
                                                        MouseLeave="OnFoundationRebarPreviewCanvasMouseLeave"
                                                        MouseWheel="OnFoundationRebarPreviewCanvasMouseWheel"
                                                        SizeChanged="OnFoundationRebarPreviewSurfaceSizeChanged" />
                                            </Border>

                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0" x:Name="FoundationRebarPreviewInfoText"
                                                       Foreground="#4B5A73" FontSize="11" TextWrapping="Wrap"
                                                       Text="3D / Plan / Section A-A / Section B-B preview panels for foundation reinforcement layout." />
                                        </Grid>
                                    </GroupBox>

                                    <ScrollViewer Grid.Row="1" Grid.Column="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  Margin="0,0,0,8"
                                                  Background="#ECECEC"
                                                  Visibility="Collapsed">
                                        <Border Padding="6"
                                                BorderBrush="{StaticResource FoundationNavPanelBorderBrush}"
                                                BorderThickness="1"
                                                Background="#EDEDED">
                                        <StackPanel MinWidth="512">
                                            <GroupBox Header="Host Foundation" Margin="0,0,0,8">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="FoundationRebarHostTextBox"
                                                             Height="24"
                                                             IsReadOnly="True"
                                                             Text="(not selected)"
                                                             Background="#FAFAFA" />
                                                    <Button x:Name="FoundationRebarPickHostButton"
                                                            Grid.Column="2"
                                                            Width="82"
                                                            Height="24"
                                                            Content="Pick"
                                                            Click="OnFoundationRebarPickHostClick" />
                                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Type:" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        <ComboBox Grid.Column="1"
                                                                  Height="22"
                                                                  x:Name="FoundationRebarTypeModeCombo"
                                                                  SelectionChanged="OnFoundationRebarPreviewSelectionChanged"
                                                                  Visibility="Collapsed">
                                                            <ComboBoxItem Content="Isolated Footing" IsSelected="True" />
                                                            <ComboBoxItem Content="Strip Footing" />
                                                            <ComboBoxItem Content="Pile Cap" />
                                                            <ComboBoxItem Content="Raft / Mat" />
                                                        </ComboBox>
                                                        <TextBlock Grid.Column="0" Text="Scope:" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                        <ComboBox Grid.Column="1"
                                                                  Height="22"
                                                                  x:Name="FoundationRebarScopeCombo"
                                                                  SelectionChanged="OnFoundationRebarPreviewSelectionChanged">
                                                            <ComboBoxItem Content="Selected Host" IsSelected="True" />
                                                            <ComboBoxItem Content="Same Type (View)" />
                                                            <ComboBoxItem Content="Same Type (Project)" />
                                                        </ComboBox>
                                                    </Grid>
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Preview Options (Auto Geometry)" Margin="0,0,0,8" Visibility="Collapsed">
                                                    <Grid Margin="6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="L (mm):" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBox x:Name="FoundationRebarLengthMmTextBox"
                                                             Grid.Column="1"
                                                             Height="22"
                                                             Text="2500"
                                                             TextChanged="OnFoundationRebarPreviewTextChanged"
                                                             Visibility="Collapsed" />
                                                    <TextBlock Grid.Column="3" Text="B (mm):" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBox x:Name="FoundationRebarWidthMmTextBox"
                                                             Grid.Column="4"
                                                             Height="22"
                                                             Text="2500"
                                                             TextChanged="OnFoundationRebarPreviewTextChanged"
                                                             Visibility="Collapsed" />
                                                    <TextBlock Grid.Column="6" Text="T (mm):" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBox x:Name="FoundationRebarThicknessMmTextBox"
                                                             Grid.Column="7"
                                                             Height="22"
                                                             Text="600"
                                                             TextChanged="OnFoundationRebarPreviewTextChanged"
                                                             Visibility="Collapsed" />

                                                    <TextBlock Grid.Row="1" Text="Ped. H:" Margin="0,6,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBox x:Name="FoundationRebarPedestalHeightMmTextBox"
                                                             Grid.Row="1"
                                                             Grid.Column="1"
                                                             Margin="0,6,0,0"
                                                             Height="22"
                                                             Text="500"
                                                             TextChanged="OnFoundationRebarPreviewTextChanged"
                                                             Visibility="Collapsed" />
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Ped. W:" Margin="0,6,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBox x:Name="FoundationRebarPedestalWidthMmTextBox"
                                                             Grid.Row="1"
                                                             Grid.Column="4"
                                                             Margin="0,6,0,0"
                                                             Height="22"
                                                             Text="600"
                                                             TextChanged="OnFoundationRebarPreviewTextChanged"
                                                             Visibility="Collapsed" />
                                                    <TextBlock Grid.Row="1" Grid.Column="6" Text="Ped. B:" Margin="0,6,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                                    <TextBox x:Name="FoundationRebarPedestalDepthMmTextBox"
                                                             Grid.Row="1"
                                                             Grid.Column="7"
                                                             Margin="0,6,0,0"
                                                             Height="22"
                                                             Text="600"
                                                             TextChanged="OnFoundationRebarPreviewTextChanged"
                                                             Visibility="Collapsed" />

                                                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="8" Margin="0,8,0,0">
                                                        <CheckBox x:Name="FoundationRebarShowDimensionsCheckBox"
                                                                  Content="Show dimensions in preview"
                                                                  IsChecked="True"
                                                                  Checked="OnFoundationRebarPreviewInputToggled"
                                                                  Unchecked="OnFoundationRebarPreviewInputToggled" />
                                                        <CheckBox x:Name="FoundationRebarShowBarMarkersCheckBox"
                                                                  Content="Show bar markers"
                                                                  Margin="12,0,0,0"
                                                                  IsChecked="True"
                                                                  Checked="OnFoundationRebarPreviewInputToggled"
                                                                  Unchecked="OnFoundationRebarPreviewInputToggled" />
                                                    </WrapPanel>
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Rebar Types" Margin="0,0,0,8" Visibility="Collapsed">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Top/Bottom Main:" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1"
                                                              Margin="8,0,0,0"
                                                              Height="22"
                                                              x:Name="FoundationRebarMainBarTypeCombo"
                                                              SelectionChanged="OnFoundationRebarPreviewSelectionChanged" />
                                                    <TextBlock Grid.Row="1" Text="Distribution Bar:" Margin="0,6,0,0" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Row="1"
                                                              Grid.Column="1"
                                                              Margin="8,6,0,0"
                                                              Height="22"
                                                              x:Name="FoundationRebarDistributionBarTypeCombo"
                                                              SelectionChanged="OnFoundationRebarPreviewSelectionChanged" />
                                                    <TextBlock Grid.Row="2" Text="Link/Stirrup Bar:" Margin="0,6,0,0" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Row="2"
                                                              Grid.Column="1"
                                                              Margin="8,6,0,0"
                                                              Height="22"
                                                              x:Name="FoundationRebarLinkBarTypeCombo"
                                                              SelectionChanged="OnFoundationRebarPreviewSelectionChanged" />
                                                </Grid>
                                            </GroupBox>

                                            <GroupBox Header="Quick Presets" Margin="0,0,0,8" Visibility="Collapsed">
                                                <StackPanel Margin="6">
                                                    <WrapPanel>
                                                        <Button Width="96" Height="24" Margin="0,0,6,6" Content="Isolated" Tag="isolated" Click="OnFoundationRebarApplyPresetClick" />
                                                        <Button Width="96" Height="24" Margin="0,0,6,6" Content="Strip" Tag="strip" Click="OnFoundationRebarApplyPresetClick" />
                                                        <Button Width="96" Height="24" Margin="0,0,6,6" Content="Pile Cap" Tag="pilecap" Click="OnFoundationRebarApplyPresetClick" />
                                                        <Button Width="96" Height="24" Margin="0,0,6,6" Content="Raft / Mat" Tag="raft" Click="OnFoundationRebarApplyPresetClick" />
                                                    </WrapPanel>
                                                    <WrapPanel>
                                                        <Button Width="96" Height="24" Margin="0,0,6,0" Content="Dense Ties" Tag="dense" Click="OnFoundationRebarApplyPresetClick" />
                                                        <Button Width="96" Height="24" Margin="0,0,6,0" Content="Economy" Tag="economy" Click="OnFoundationRebarApplyPresetClick" />
                                                        <Button Width="198" Height="24" Content="Sync From Type + Scope" Tag="sync" Click="OnFoundationRebarApplyPresetClick" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </GroupBox>

                                            <GroupBox Header="Dynamic Parameters" Margin="0,0,0,8">
                                                <TabControl Margin="6"
                                                            Padding="0"
                                                            Background="#EFEFEF"
                                                            BorderBrush="#BCC1C8"
                                                            BorderThickness="1"
                                                            ItemContainerStyle="{StaticResource FoundationRebarCloneTabItemStyle}"
                                                            x:Name="FoundationRebarParameterTabControl"
                                                            SelectionChanged="OnFoundationRebarPreviewSelectionChanged">
                                                    <TabItem x:Name="FoundationRebarEasyParameterTabItem" Header="Main Bars">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                      Background="#F5F5F5">
                                                            <StackPanel Margin="8">
                                                                <Border BorderBrush="#D5DDE8" BorderThickness="1" Background="#F8FAFD" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="70" />
                                                                            <ColumnDefinition Width="10" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="70" />
                                                                            <ColumnDefinition Width="10" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Top Cover:" VerticalAlignment="Center" />
                                                                        <TextBox Grid.Column="1" Height="22"
                                                                                 Text="{Binding Text, ElementName=FoundationRebarTopCoverMmTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <TextBlock Grid.Column="3" Text="Bottom Cover:" VerticalAlignment="Center" />
                                                                        <TextBox Grid.Column="4" Height="22"
                                                                                 Text="{Binding Text, ElementName=FoundationRebarBottomCoverMmTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                        <TextBlock Grid.Column="6" Text="Side Cover:" VerticalAlignment="Center" />
                                                                        <TextBox Grid.Column="7" Height="22"
                                                                                 Text="{Binding Text, ElementName=FoundationRebarSideCoverMmTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>
                                                                </Border>

                                                                <GroupBox Header="Bottom Rebar" Margin="0,0,0,8">
                                                                    <Grid Margin="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="160" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="1" />
                                                                            <ColumnDefinition Width="12" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <CheckBox Content="Bottom Reinforcement"
                                                                                      IsChecked="{Binding IsChecked, ElementName=FoundationRebarCreateBottomBarsCheckBox, Mode=TwoWay}" />
                                                                            <TextBlock Text="Main Layer Direction:" FontWeight="SemiBold" />
                                                                            <RadioButton Content="Longitudinal Bars" IsEnabled="False" IsChecked="True" Margin="0,4,0,0" GroupName="FoundationEasyBottomDir" />
                                                                            <RadioButton Content="Transversal Bars" IsEnabled="False" Margin="0,4,0,0" GroupName="FoundationEasyBottomDir" />
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" Background="#D5DDE8" Width="1" />
                                                                        <Grid Grid.Column="4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                                                                            <TextBlock Text="X-Direction:" VerticalAlignment="Center" />
                                                                            <TextBox x:Name="FoundationRebarEasyBottomXSpecTextBox"
                                                                                     Grid.Column="1" Margin="8,0,0,0" Height="22"
                                                                                     Text="{Binding Text, ElementName=FoundationRebarBottomXSpecTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                     LostFocus="OnFoundationRebarShorthandSpecLostFocus"
                                                                                     PreviewKeyDown="OnFoundationRebarShorthandSpecPreviewKeyDown" />
                                                                            <TextBlock Grid.Row="1" Text="Y-Direction:" Margin="0,6,0,0" VerticalAlignment="Center" />

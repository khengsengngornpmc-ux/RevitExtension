                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Top Foundation Offset (mm):" VerticalAlignment="Center" />
                                                    <TextBox x:Name="SoilExcavationTopOffsetTextBox"
                                                     Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                     Height="26"
                                                     Text="0" />
                                                    <TextBlock Grid.Row="1"
                                                       Text="Bottom Lean Offset (mm):"
                                                       VerticalAlignment="Center"
                                                       Margin="0,6,0,0" />
                                                    <TextBox x:Name="SoilExcavationBaseOffsetTextBox"
                                                     Grid.Row="1"
                                                     Grid.Column="1"
                                                     Margin="8,6,0,0"
                                                     Height="26"
                                                     Text="300" />
                                                    <TextBlock Grid.Row="2"
                                                       Text="Angle (deg from horizontal, e.g. 135):"
                                                       VerticalAlignment="Center"
                                                       Margin="0,6,0,0" />
                                                    <TextBox x:Name="SoilExcavationAngleTextBox"
                                                     Grid.Row="2"
                                                     Grid.Column="1"
                                                     Margin="8,6,0,0"
                                                     Height="26"
                                                     Text="135" />

                                                <StackPanel Margin="8">
                                                    <CheckBox Content="Doors" />
                                                    <CheckBox Content="Floors" />
                                                    <CheckBox Content="HVAC Zones" />
                                                    <CheckBox Content="Lines" />
                                                    <CheckBox Content="Materials" />
                                                    <CheckBox Content="Model Groups" />
                                                    <CheckBox Content="Stairs" />
                                                    <CheckBox Content="Structural Columns" />
                                                    <CheckBox Content="Structural Foundations" />
                                                    <CheckBox Content="Structural Framing" />
                                                    <CheckBox Content="Views" />
                                                    <CheckBox Content="Walls" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </GroupBox>

                                        <GroupBox Grid.Row="2" Grid.Column="0" Header="" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Margin="8">
                                                <CheckBox Content="Hide un-checked categories" Margin="0,0,12,0" />
                                                <CheckBox Content="Include Linked Files" Margin="0,0,12,0" />
                                                <CheckBox Content="Export by Type ID" />
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Grid.Row="0" Grid.Column="1" Header="Available Parameters" Margin="0,0,8,8">
                                            <StackPanel Margin="8">
                                                <ComboBox Height="26" Text="Instance,Type,Read-only" Margin="0,0,0,6" />
                                                <TextBox Height="24" Text="Search" />
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Grid.Row="1" Grid.Column="1" Header="Parameters" Margin="0,0,8,8">

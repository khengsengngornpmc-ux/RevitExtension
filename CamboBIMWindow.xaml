                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Beam Layer:" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="LayerCombo_Beam"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       SelectionChanged="OnCad2ModelSourceSelectionChanged"
                                                       Height="26" />
                                                    <TextBlock Grid.Row="1" Text="Label Layer:" VerticalAlignment="Center" Margin="0,6,0,0" />
                                                    <ComboBox x:Name="BeamLabelLayerCombo"
                                                       Grid.Row="1"

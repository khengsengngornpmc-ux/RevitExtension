  <Target Name="DeployRevitAddinManifest" AfterTargets="Build" Condition="'$(DisableRevitDeploy)' != 'true'">
    <PropertyGroup>
      <_RevitDeployExePath>$(ProjectDir)scripts\deploy-revit2024-addin.exe</_RevitDeployExePath>
      <_RevitDeployScriptPath>$(ProjectDir)scripts\deploy-revit2024-addin.ps1</_RevitDeployScriptPath>
    </PropertyGroup>

    <Exec Condition="Exists('$(_RevitDeployExePath)')"
          Command="&quot;$(_RevitDeployExePath)&quot; --no-ui --configuration &quot;$(Configuration)&quot; --platform &quot;$(Platform)&quot; --revit-year 2024 --assembly &quot;$(TargetPath)&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RevitDeployExeExitCode" />
    </Exec>

    <Exec Condition="(!Exists('$(_RevitDeployExePath)') Or '$(_RevitDeployExeExitCode)' != '0') And Exists('$(_RevitDeployScriptPath)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RevitDeployScriptPath)&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -AssemblyPath &quot;$(TargetPath)&quot; -RevitYear 2024"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RevitDeployScriptExitCode" />
    </Exec>

    <PropertyGroup>
      <_RevitDeployFinalExitCode Condition="'$(_RevitDeployExeExitCode)' == '0'">0</_RevitDeployFinalExitCode>
      <_RevitDeployFinalExitCode Condition="'$(_RevitDeployFinalExitCode)' == '' and '$(_RevitDeployScriptExitCode)' != ''">$(_RevitDeployScriptExitCode)</_RevitDeployFinalExitCode>
      <_RevitDeployFinalExitCode Condition="'$(_RevitDeployFinalExitCode)' == ''">0</_RevitDeployFinalExitCode>
    </PropertyGroup>

    <Warning Condition="'$(_RevitDeployFinalExitCode)' != '0'"
             Text="Revit add-in deploy step failed (exit code $(_RevitDeployFinalExitCode)). Build output is still available at $(TargetPath)." />
  </Target>

  <Target Name="FailWhenRevit2024ApiMissing" BeforeTargets="CoreCompile" Condition="'$(RevitApiAvailable)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Text="Revit 2024 API was not found at $(RevitInstallDir). This PC is configured for Revit 2025 development; use CamboBIM.Revit2025.Addin.sln or install Revit 2024 to build this project." />
  </Target>

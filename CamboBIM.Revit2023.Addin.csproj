  <Target Name="DeployRevitAddinManifest" AfterTargets="Build" Condition="'$(DisableRevitDeploy)' != 'true'">
    <PropertyGroup>
      <_RevitDeployExePath>$(ProjectDir)scripts\deploy-revit2023-addin.exe</_RevitDeployExePath>
      <_RevitDeployScriptPath>$(ProjectDir)scripts\deploy-revit2023-addin.ps1</_RevitDeployScriptPath>
    </PropertyGroup>

    <Exec Condition="Exists('$(_RevitDeployExePath)')"
          Command="&quot;$(_RevitDeployExePath)&quot; --no-ui --configuration &quot;$(Configuration)&quot; --platform &quot;$(Platform)&quot; --revit-year 2023 --assembly &quot;$(TargetPath)&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RevitDeployExeExitCode" />
    </Exec>

    <Exec Condition="(!Exists('$(_RevitDeployExePath)') Or '$(_RevitDeployExeExitCode)' != '0') And Exists('$(_RevitDeployScriptPath)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RevitDeployScriptPath)&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -AssemblyPath &quot;$(TargetPath)&quot; -RevitYear 2023"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RevitDeployScriptExitCode" />
    </Exec>

    <PropertyGroup>
      <_RevitDeployFinalExitCode Condition="'$(_RevitDeployExeExitCode)' == '0'">0</_RevitDeployFinalExitCode>
      <_RevitDeployFinalExitCode Condition="'$(_RevitDeployFinalExitCode)' == '' and '$(_RevitDeployScriptExitCode)' != ''">$(_RevitDeployScriptExitCode)</_RevitDeployFinalExitCode>
      <_RevitDeployFinalExitCode Condition="'$(_RevitDeployFinalExitCode)' == ''">0</_RevitDeployFinalExitCode>
    </PropertyGroup>

    <Warning Condition="'$(_RevitDeployFinalExitCode)' != '0'"
             Text="Revit add-in deploy step failed (exit code $(_RevitDeployFinalExitCode)). Build output is still available at $(TargetPath)." />
  </Target>

  <Target Name="FailWhenRevit2023ApiMissing" BeforeTargets="CoreCompile" Condition="'$(RevitApiAvailable)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Text="Revit 2023 API was not found at $(RevitInstallDir). Install Revit 2023 or pass -p:RevitInstallDir=&quot;...\Autodesk\Revit 2023\&quot; to build this project." />
  </Target>

    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CamboBIM.Revit2023.Addin</RootNamespace>
    <AssemblyName>CamboBIM.Revit2023.Addin</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == '' and Exists('$(ProgramW6432)\Autodesk\Revit 2023\RevitAPI.dll')">$(ProgramW6432)\Autodesk\Revit 2023\</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == '' and Exists('C:\Program Files\Autodesk\Revit 2023\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2023\</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2023\</RevitInstallDir>
    <RevitApiAvailable Condition="Exists('$(RevitInstallDir)RevitAPI.dll')">true</RevitApiAvailable>
    <RevitApiAvailable Condition="'$(RevitApiAvailable)' == ''">false</RevitApiAvailable>
  </PropertyGroup>


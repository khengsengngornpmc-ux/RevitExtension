<Window x:Class="CamboBIM.Revit2024.Addin.BoredPileToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Piles from AutoCAD"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Generate CAD to Bored Pile"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="1">
            <GroupBox Header="CAD Import">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AutoCAD Import:" VerticalAlignment="Center" />
                    <TextBox x:Name="ImportNameText"
                             Grid.Column="1"
                             Margin="8,0,8,0"
                             IsReadOnly="True"
                             Text="(not selected)" />
                    <Button Grid.Column="2"
                            Width="120"
                            Height="26"
                            Content="Pick Import"
                            Click="OnPickImportClick" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Selection Mode">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mode:" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,8,0">
                        <RadioButton x:Name="SelectModeRadio"
                                     Content="Select Objects"
                                     IsChecked="True"
                                     Checked="OnSelectionModeChanged"
                                     Margin="0,0,16,0" />
                        <RadioButton x:Name="LayerModeRadio"
                                     Content="By Layer"
                                     Checked="OnSelectionModeChanged" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="120"
                            Height="26"
                            Content="Pick Objects"
                            Click="OnPickObjectsClick" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Layer Filter">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Layer:" VerticalAlignment="Center" />
                    <ComboBox x:Name="LayerCombo"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              Height="24" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Foundation Families">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Bored Pile:" VerticalAlignment="Center" />
                    <ComboBox x:Name="BoredPileCombo"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              Height="24" />

                    <TextBlock Grid.Row="1" Text="Spun Pile:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              x:Name="SpunPileCombo"
                              Margin="8,6,0,0"
                              Height="24" />

                    <TextBlock Grid.Row="2" Text="Sheet Pile:" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              x:Name="SheetPileCombo"
                              Margin="8,6,0,0"
                              Height="24" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Level">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Base Level:" VerticalAlignment="Center" />
                    <ComboBox x:Name="BaseLevelCombo"
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              Height="24" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Text="Ready." />
            <Button Grid.Column="1"
                    Width="120"
                    Height="28"
                    Margin="8,0,8,0"
                    Content="Generate"
                    Click="OnGenerateClick" />
            <Button Grid.Column="2"
                    Width="90"
                    Height="28"
                    Content="Close"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>

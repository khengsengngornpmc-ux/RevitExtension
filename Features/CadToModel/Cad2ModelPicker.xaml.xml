<Window x:Class="CamboBIM.Revit2024.Addin.Cad2ModelPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD2MODEL - Layout to Column"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Topmost="True">

	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel>
			<TextBlock Text="Select CAD Layout (Layer)"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

			<ComboBox x:Name="LayerCombo" Width="300"/>

			<TextBlock Text="Column Height (mm)"
                       Margin="0,12,0,6"/>

			<TextBox x:Name="HeightText"
                     Width="120"
                     Text="3000"/>
		</StackPanel>

		<StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
			<Button Width="80" Margin="0,0,8,0"
                    Content="Cancel"
                    Click="Cancel_Click"/>
			<Button Width="80"
                    Content="OK"
                    IsDefault="True"
                    Click="Ok_Click"/>
		</StackPanel>
	</Grid>
</Window>

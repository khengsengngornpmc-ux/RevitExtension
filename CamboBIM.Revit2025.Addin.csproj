  <Target Name="DeployRevitAddinManifest" AfterTargets="Build" Condition="'$(DisableRevitDeploy)' != 'true'">
    <PropertyGroup>
      <_RevitDeployScriptPath>$(ProjectDir)scripts\deploy-revit2025-addin.ps1</_RevitDeployScriptPath>
    </PropertyGroup>

    <Exec Condition="Exists('$(_RevitDeployScriptPath)')"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RevitDeployScriptPath)&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -AssemblyPath &quot;$(TargetPath)&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RevitDeployScriptExitCode" />
    </Exec>

    <Warning Condition="'$(_RevitDeployScriptExitCode)' != '' and '$(_RevitDeployScriptExitCode)' != '0'"
             Text="Revit 2025 add-in deploy step failed (exit code $(_RevitDeployScriptExitCode)). Build output is still available at $(TargetPath)." />
  </Target>

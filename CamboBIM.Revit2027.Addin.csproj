<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CamboBIM.Revit2024.Addin</RootNamespace>
    <AssemblyName>CamboBIM.Revit2027.Addin</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == '' and Exists('$(ProgramW6432)\Autodesk\Revit 2027\RevitAPI.dll')">$(ProgramW6432)\Autodesk\Revit 2027\</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == '' and Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2027\</RevitInstallDir>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2027\</RevitInstallDir>
    <RevitApiAvailable Condition="Exists('$(RevitInstallDir)RevitAPI.dll')">true</RevitApiAvailable>
    <RevitApiAvailable Condition="'$(RevitApiAvailable)' == ''">false</RevitApiAvailable>
    <StartAction>Program</StartAction>
    <StartProgram>$(RevitInstallDir)Revit.exe</StartProgram>
    <StartWorkingDirectory>$(RevitInstallDir)</StartWorkingDirectory>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' Or '$(Configuration)|$(Platform)' == 'Debug|Any CPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Revit2027\Debug\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DefineConstants>DEBUG;TRACE;REVIT2027;REVIT2025_OR_GREATER</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' Or '$(Configuration)|$(Platform)' == 'Release|Any CPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Revit2027\Release\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DefineConstants>TRACE;REVIT2027;REVIT2025_OR_GREATER</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\Revit2027\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;REVIT2027;REVIT2025_OR_GREATER</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\Revit2027\x64\Release\</OutputPath>
    <DefineConstants>TRACE;REVIT2027;REVIT2025_OR_GREATER</DefineConstants>
    <Optimize>true</Optimize>
    <WarningLevel>0</WarningLevel>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>
  <ItemGroup Condition="'$(RevitApiAvailable)' == 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RevitApiAvailable)' == 'true'">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitApiAvailable)' != 'true' and '$(DesignTimeBuild)' == 'true'">
    <Compile Include="Properties\Revit2027MissingApiDesignTimeStub.cs" />
  </ItemGroup>
  <Import Project="CamboBIM.SharedProjectItems.targets" Condition="Exists('CamboBIM.SharedProjectItems.targets')" />
  <Target Name="DeployRevitAddinManifest" AfterTargets="Build" Condition="'$(DisableRevitDeploy)' != 'true'">
    <PropertyGroup>
      <_RevitDeployScriptPath>$(ProjectDir)scripts\deploy-revit2027-addin.ps1</_RevitDeployScriptPath>
    </PropertyGroup>
    <Exec Condition="Exists('$(_RevitDeployScriptPath)')" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_RevitDeployScriptPath)&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -AssemblyPath &quot;$(TargetPath)&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_RevitDeployScriptExitCode" />
    </Exec>
    <Warning Condition="'$(_RevitDeployScriptExitCode)' != '' and '$(_RevitDeployScriptExitCode)' != '0'" Text="Revit 2027 add-in deploy step failed (exit code $(_RevitDeployScriptExitCode)). Build output is still available at $(TargetPath)." />
  </Target>
  <Target Name="FailWhenRevit2027ApiMissing" BeforeTargets="CoreCompile" Condition="'$(RevitApiAvailable)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Text="Revit 2027 API was not found at $(RevitInstallDir). Install Revit 2027 or pass -p:RevitInstallDir=&quot;...\Autodesk\Revit 2027\&quot; to build this project." />
  </Target>
</Project>